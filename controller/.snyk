  # Path-scoped: commons-io and kotlin-stdlib are also shipped (and fixed there);
  # these ignore ONLY the UTP tooling path, so a shipped regression still alerts.
  SNYK-JAVA-COMMONSIO-8161190:
    - 'com.android.tools.utp:android-test-plugin-host-emulator-control@31.4.1 > commons-io:commons-io@2.13.0':
        reason: 'Not shipped. UTP test tooling (android-test-plugin-host-emulator-control / -retention, AGP 8.4.1) bundles commons-io 2.13.0. The shipped commons-io is fixed and pinned at 2.14.0, so this path-scoped ignore does not hide a shipped finding; a shipped regression on another version or path still alerts. See controller/docs/SECURITY-TRIAGE.md. Re-review at the next AGP/UTP upgrade.'
        expires: 2027-09-30T00:00:00.000Z
