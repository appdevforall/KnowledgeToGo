<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- K2GO-504: Firebase Analytics merges advertising permissions. K2Go uses no advertising ID and no
         ad attribution, so remove them: no build declares a permission it does not use. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application>
        <!-- ADFA-4466 Phase 1 / K2GO-402: privacy hardening for Firebase Analytics. Disable
             Advertising ID / SSAID collection and ad personalization (K2Go may serve minors;
             operational analytics only). These keys live in the standard flavor: the fdroid build
             links no Firebase, so they would be dead weight (and a stray Google reference) there. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- K2GO-504: collection starts OFF. AnalyticsClient.applyConsent() turns it on only after the
             user opts in, so nothing is sent before consent. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
    </application>
</manifest>
