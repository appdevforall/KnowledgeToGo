<?xml version="1.0" encoding="utf-8"?>
<!--
  ADFA-4954 — strings owned by the Kolibri (Courses) content feature.

  A per-feature file rather than more rows in strings_k2go.xml: every feature that
  edits the shared file collides with every other one, and Android merges all
  <resources> files anyway.

  Deliberately small. The seeding screen reuses the generic strings the ZIM flow
  already owns — k2go_zim_prep_detail_fmt, k2go_zim_all_ready,
  k2go_zim_item_failed_suffix, k2go_zim_retry, k2go_zim_preparing_sub,
  k2go_zim_run_bg — whose text says nothing about ZIM. Duplicating them under a
  kolibri_ prefix would mean the same English sentence translated twice into 33
  languages and drifting apart. Renaming them properly is a separate change: it
  touches every locale file for a feature this PR is not otherwise editing.
-->
<resources>

    <!-- Foreground-service notification while channels are being seeded. -->
    <string name="k2go_kolibri_dl_channel_name">Course downloads</string>
    <string name="k2go_kolibri_dl_notif_title">Adding courses</string>
    <string name="k2go_kolibri_notif_cancel">Cancel</string>

    <!-- Seeding detail screen, reached from the progress index or the notification. -->
    <string name="k2go_kolibri_seeding_title">Adding your courses</string>

    <!-- Courses picker (ADFA-4954). Only the strings whose text is genuinely about
         courses live here; the picker reuses the ZIM family's generic ones
         (k2go_zim_search_hint, _loading, _lang_fmt, _lang_state_system,
         _lang_state_manual, _lang_mul, _change, _storage_fmt, _review_fmt,
         _confirm_title, _total, _fits_fmt, _nofit_fmt, _add_setup_fmt, _grp_all,
         k2go_lang_follow_system, k2go_zc_sort_size, k2go_zc_sort_name,
         k2go_zc_sort_name_desc, k2go_zc_count_items, k2go_zc_count_results,
         k2go_zc_nospace), whose wording says nothing about ZIM.

         Sharing the language strings is not just thrift: the wizard has ONE content
         language, so both catalogs must describe it identically. -->
    <string name="k2go_kolibri_unavailable">Couldn\'t read the course catalog included with the app.</string>
    <string name="k2go_kolibri_no_match">No courses match your search.</string>
    <!-- ADFA-5094: catalog freshness on the picker; %1$s is the catalog's generated date. -->
    <string name="k2go_kolibri_catalog_updated">Catalog updated on %1$s</string>
    <string name="k2go_kolibri_size_unknown">Size unknown</string>
    <string name="k2go_kolibri_confirm_sub">The courses you chose.</string>
    <!-- The third fit state: the total is a floor, not a figure, because at least one
         chosen course publishes no size. Warn, but do not block. -->
    <string name="k2go_kolibri_fit_unknown">Some sizes aren\'t published, so this total may be higher. You can continue.</string>
    <string name="k2go_kolibri_takes_body">Courses can be very large and take a long time to download, especially on a slow connection. The download starts after your system is installed, keeps going in the background, and resumes if interrupted.</string>

    <string name="k2go_kolibri_none_in_lang">No courses in %1$s yet · Change language</string>
    <string name="k2go_kolibri_resources_fmt">%1$d resources</string>
    <string name="k2go_kolibri_tree_offline">Couldn\'t reach the course library. Tap to try again.</string>
    <string name="k2go_kolibri_topic_empty">Nothing inside this folder yet.</string>
    <string name="k2go_kolibri_included">Included with the folder above</string>
    <string name="k2go_kolibri_open_topic">Open folder</string>
    <string name="k2go_kolibri_choose_topics">Choose topics</string>
    <string name="k2go_kolibri_narrowed_fmt">%1$d topics selected</string>
    <string name="k2go_kolibri_whole_course">Whole course</string>
    <string name="k2go_kolibri_checking">Checking what this device can do…</string>
    <string name="k2go_kolibri_not_installed">Courses isn\'t installed on this system, so content can\'t be added.</string>
    <string name="k2go_kolibri_system_damaged">Your system needs to be repaired before content can be added.</string>
    <string name="k2go_kolibri_start_system_first">Start your system first, then this download can begin.</string>
    <string name="k2go_kolibri_busy">Another download is running. Try again when it finishes.</string>
    <string name="k2go_kolibri_already_here">Already on this device</string>
    <string name="k2go_kolibri_partly_here">Partly on this device</string>
    <string name="k2go_kolibri_nothing_to_add">Everything you picked is already on this device.</string>
    <string name="k2go_kolibri_go_to_library">Done — go to my library</string>
    <string name="k2go_kolibri_failed_fmt">%1$d course(s) didn\'t finish.</string>
    <string name="k2go_kolibri_retry_before_leaving">Retry the ones that failed before you leave — leaving clears this list.</string>
</resources>
