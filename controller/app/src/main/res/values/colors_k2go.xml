<?xml version="1.0" encoding="utf-8"?>
<!-- K2Go redesign tokens (ADFA-4725). Status colors mean status only; teal = brand. -->
<resources>
    <color name="k2go_ink">#14211F</color>
    <color name="k2go_paper">#FBF8F3</color>
    <!-- ADFA-4814: boot-gate letterbox behind the intro/outro Lottie. Must match the animation's
         own BG layer (#FBF8F3) and stay the same in light + dark, so the margin reads as continuous
         (no override in values-night). -->
    <color name="k2go_boot_bg">#FBF8F3</color>
    <!-- ADFA-4814: the boot screen is always a light surface (k2go_boot_bg), so the install-progress
         text drawn over it must stay dark in both themes — k2go_ink/k2go_muted flip to light in dark
         mode, which turned the status line invisible on the light gate. Fixed values, no night override. -->
    <color name="k2go_boot_ink">#14211F</color>
    <color name="k2go_boot_muted">#5C6360</color>
    <!-- ADFA-5119: brand accent for a filled primary action on the boot gate (the Retry button). The
         same fixed-surface rule as the two above: k2go_teal flips to #4FB3BA at night, which over this
         always-light paper is a washed-out turquoise. This is the light-mode teal, pinned. No
         values-night override, on purpose. -->
    <color name="k2go_boot_accent">#0E5C63</color>
    <!-- ADFA-5119: the boot-gate progress track. k2go_hairline flips from #D9D4C8 to #2A3D3B at
         night, so on this always-light paper the track went dark while the fill went pale — the two
         swapped roles and the bar lost most of its contrast. Fixed light value, no night override. -->
    <color name="k2go_boot_track">#D9D4C8</color>
    <color name="k2go_surface">#EFEBE2</color>
    <color name="k2go_teal">#0E5C63</color>
    <color name="k2go_leaf">#2E9E5B</color>
    <color name="k2go_amber">#F2A23C</color>
    <color name="k2go_amber_text">#B0740F</color>
    <color name="k2go_clay">#C4462F</color>
    <color name="k2go_notice_ink">#3A2320</color>  <!-- fixed dark; notice bg is always light pink -->
    <color name="k2go_info_ink">#0E5C63</color>  <!-- ADFA-4955: fixed dark teal for text over k2go_info_bg (fixed-light); no values-night override so it stays readable in dark. -->
    <color name="k2go_warn_ink">#8A5A00</color>  <!-- ADFA-4958: fixed dark amber for text over k2go_warn_bg (fixed-light); no values-night override. -->
    <!-- ADFA-4901: install log terminal — fixed dark surface + light-green text in both themes
         (reused by all proot module install logs). -->
    <color name="k2go_terminal_bg">#0F1512</color>
    <color name="k2go_terminal_text">#9FE1CB</color>
    <color name="k2go_muted">#5C6360</color>
    <color name="k2go_hairline">#D9D4C8</color>
    <color name="k2go_on_teal">#FBF8F3</color>

    <!-- ADFA-4850: book-cover placeholder palette + selection/library bands. These are drawn with
         white text on top, so they must stay dark enough for that contrast in BOTH themes — hence
         fixed values with NO values-night override (same reasoning as k2go_boot_* above). Using
         semantic tokens like k2go_ink here made covers flip to near-white in dark mode and hid the
         label. -->
    <color name="k2go_cover_1">#0E5C63</color>  <!-- teal -->
    <color name="k2go_cover_2">#3A5A8C</color>  <!-- indigo -->
    <color name="k2go_cover_3">#6E3B7A</color>  <!-- plum -->
    <color name="k2go_cover_4">#B5432E</color>  <!-- clay -->
    <color name="k2go_cover_5">#2E7D4F</color>  <!-- forest -->
    <color name="k2go_cover_6">#4A5568</color>  <!-- slate -->
    <!-- ADFA-5248: cover state bands. The band is a light (cream) pill so it reads on ANY of the
         6 covers above (all medium/dark); the semantic hue lives in the TEXT, not the fill, which
         is why the old green fill vanished on the green covers. Mode-independent (sits on a fixed
         cover color), so no -night twin. -->
    <color name="k2go_band_surface">#FBF8F3</color>  <!-- cream band pill: high contrast on every cover -->
    <color name="k2go_band_library">#12633C</color>  <!-- band TEXT (dark green): already in your books -->
    <color name="k2go_band_selected">#3A403E</color> <!-- band TEXT (dark gray): selected to add -->

    <!-- ADFA-4886: WebView nav "Exit" tint. Red is the universal alert/exit color; kept fixed in
         both light and dark (no values-night override) so the exit affordance always reads the same. -->
    <color name="k2go_nav_exit">#D32F2F</color>
</resources>
