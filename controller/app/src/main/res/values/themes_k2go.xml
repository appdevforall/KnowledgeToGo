<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped Material 3 theme for the redesigned UI (ADFA-4725). Applied per-Activity; global app theme untouched. -->
<resources>
    <style name="Theme.K2Go" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/k2go_teal</item>
        <item name="colorOnPrimary">@color/k2go_on_teal</item>
        <item name="colorPrimaryContainer">@color/k2go_surface</item>
        <item name="colorOnPrimaryContainer">@color/k2go_ink</item>
        <item name="android:colorBackground">@color/k2go_paper</item>
        <item name="android:windowBackground">@color/k2go_paper</item>
        <item name="colorSurface">@color/k2go_paper</item>
        <item name="colorSurfaceContainer">@color/k2go_surface</item>
        <item name="colorOnBackground">@color/k2go_ink</item>
        <item name="colorOnSurface">@color/k2go_ink</item>
        <item name="colorOnSurfaceVariant">@color/k2go_muted</item>
        <item name="colorOutlineVariant">@color/k2go_hairline</item>
        <item name="colorError">@color/k2go_clay</item>
        <item name="colorOnError">@color/k2go_on_teal</item>
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:fontFamily">@font/atkinson_hyperlegible</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.K2Go.Display</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.K2Go.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.K2Go.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.K2Go.Label</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.K2Go.Caption</item>
        <!-- ADFA-5346: one button style app-wide. Bare <Button> in a K2Go activity inflates as a
             MaterialButton with the filled style below; secondaries opt into the Outlined/Text/Destructive
             variants. All share ShapeAppearance.K2Go.Button (official M3 full/pill), so the corner lives in
             one place and primary/secondary never disagree. -->
        <item name="materialButtonStyle">@style/Widget.K2Go.Button</item>
    </style>

    <!-- ADFA-5346: shared button shape — official Material 3 fully-rounded (stadium/pill). Change here to
         restyle every button at once. -->
    <style name="ShapeAppearance.K2Go.Button" parent="ShapeAppearance.Material3.Corner.Full" />

    <!-- ADFA-5346: one button text size app-wide, so every button reads the same regardless of screen. -->
    <style name="TextAppearance.K2Go.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Filled primary (teal container). The default for a bare <Button>. The size items
         (minHeight + zero insets + one text appearance) live here so buttons never disagree on size;
         layouts should NOT set their own padding/height/textAppearance on a button. -->
    <style name="Widget.K2Go.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.K2Go.Button</item>
        <item name="android:textAppearance">@style/TextAppearance.K2Go.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/k2go_teal</item>
        <item name="android:textColor">@color/k2go_on_teal</item>
    </style>

    <!-- Outlined secondary (teal outline). -->
    <style name="Widget.K2Go.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.K2Go.Button</item>
        <item name="android:textAppearance">@style/TextAppearance.K2Go.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/k2go_teal</item>
        <item name="strokeColor">@color/k2go_teal</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Text-only (low emphasis). -->
    <style name="Widget.K2Go.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.K2Go.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/k2go_teal</item>
    </style>

    <!-- Destructive outlined (clay/error outline + text) — e.g. "Turn off". -->
    <style name="Widget.K2Go.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.K2Go.Button</item>
        <item name="android:textAppearance">@style/TextAppearance.K2Go.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/k2go_clay</item>
        <item name="strokeColor">@color/k2go_clay</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- ADFA-5346: overlays that only POINT a code-built or role-switching MaterialButton at one of the
         styles above (via ContextThemeWrapper + new MaterialButton(ctx, null)). The role look stays ONLY
         in the styles — no color/recipe is duplicated in Java. Used by SettingsFragment's "Turn off" and
         CloneFragment's morphing action button. -->
    <style name="ThemeOverlay.K2Go.Button.Filled" parent="">
        <item name="materialButtonStyle">@style/Widget.K2Go.Button</item>
    </style>
    <style name="ThemeOverlay.K2Go.Button.Outlined" parent="">
        <item name="materialButtonStyle">@style/Widget.K2Go.Button.Outlined</item>
    </style>
    <style name="ThemeOverlay.K2Go.Button.Destructive" parent="">
        <item name="materialButtonStyle">@style/Widget.K2Go.Button.Destructive</item>
    </style>

    <style name="TextAppearance.K2Go.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.K2Go.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.K2Go.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.K2Go.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.K2Go.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
