<?xml version="1.0" encoding="utf-8"?>
<!--
  ADFA-5119 — TEMPORARY. THIS FILE MUST NOT SURVIVE THE PULL REQUEST.

  Every string here is user-facing and WILL be translated. `translatable="false"` is a lie told to
  lint so the logic can be finished and reviewed before the wording is settled and sent for
  translation; it is not a statement about these strings.

  It lives in a file of its own, rather than as attributes scattered through strings.xml, for one
  reason: a marker nobody is forced to remove does not get removed. The repo's real
  `translatable="false"` entries are brand names — BETA, "Knowledge to Go", "Code on the Go" — and
  these would have blended in with them and stayed in English in all 35 locales forever, invisible
  to lint and to whoever translates, because the check that would have caught it was told not to
  look. Here the file name is the reminder and `ls res/values/*pending*` is the check.

  BEFORE MERGE: move each string into strings_k2go.xml without the attribute, translate it into the
  34 locale files, and delete this file. The PR is not finished while it exists.

  Why these words matter more than most: "Pause", "Resume" and "Cancel" are what stands between a
  user on a metered connection and losing a multi-gigabyte transfer by accident. They are the last
  strings that should ship in English.
-->
<resources>

    <!-- The button that carries three states, one at a time (ADFA-5119). -->
    <string name="k2go_dl_pause" translatable="false">Pause</string>
    <string name="k2go_dl_resume" translatable="false">Resume</string>
    <string name="k2go_dl_retry" translatable="false">Retry</string>

    <!-- Abandons the download AND the tier/wishlist decision, so it is confirmed. -->
    <string name="k2go_dl_cancel" translatable="false">Cancel</string>

    <!-- Status lines for a stop nobody chose (SOFTFAILED). Mapped from Aria2Exit.Kind, never from
         Aria2Exit.label(), which is documented as English-for-logs. They name the cause only: the
         Retry button beside them already says what to do about it. -->
    <string name="k2go_dl_soft_lost" translatable="false">Connection lost</string>
    <string name="k2go_dl_soft_slow" translatable="false">The connection is too slow</string>
    <!-- UNKNOWN, including aria2's own code 1. Says only what we know. -->
    <string name="k2go_dl_soft_stopped" translatable="false">The download stopped</string>

    <!-- Status line while stopped by the user. Replaces "Downloading your library…", which would
         be a lie while nothing is moving. -->
    <string name="k2go_dl_paused" translatable="false">Download paused</string>

    <!-- Notification text while paused. Deliberately just the word: the notification is kept
         minimal for now and can gain the figure later if it turns out to be wanted. One string
         with no format argument is also one less thing for 34 translators to get wrong. -->
    <string name="k2go_dl_paused_notif" translatable="false">Paused</string>

    <!-- The confirmation. The body names both losses: the transfer and the decision. The percentage
         is not repeated — it is on screen behind the dialog. -->
    <string name="k2go_dl_cancel_title" translatable="false">Cancel the download?</string>
    <!-- Names both losses. The design's first draft named only the decision ("you'll choose your
         content again"), which left a user at 20% unaware that the transfer itself restarts. No
         figure: the percentage is on screen behind the dialog, and a number here would be a second
         place formatting the same fact. -->
    <string name="k2go_dl_cancel_body" translatable="false">The download will stop and start over from the beginning, and you will set up the base system and choose your content again.</string>
    <string name="k2go_dl_cancel_keep" translatable="false">Keep downloading</string>
    <!-- The mockup's label. OPEN QUESTION, for Luis: "Cancel it" inside a dialog reads as "dismiss
         this dialog", which competes with the gesture of closing it — a destructive button and a
         dismiss gesture sharing a word. "Discard and start over" names the outcome instead. Left as
         the mockup has it until decided, rather than changed here unilaterally. -->
    <string name="k2go_dl_cancel_confirm" translatable="false">Cancel it</string>

</resources>
