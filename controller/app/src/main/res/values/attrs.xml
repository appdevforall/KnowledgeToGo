<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="sectionBackground" format="color" />
    <attr name="sectionHeaderBackground" format="color" />
    <!-- ADFA-5192: the ProgressButton styleable was removed with the legacy tabbed UI's
         ProgressButton view (its only consumer). -->

    <!-- K2GO-374: the reusable live-log "details" panel (org.appdevforall.k2go.widget.LiveLogPanel). -->
    <declare-styleable name="LiveLogPanel">
        <!-- Height of the scrollable log area, in dp (default 180). -->
        <attr name="logMaxHeightDp" format="integer" />
        <!-- Keep the "Show details" toggle hidden until there is log content (default false). -->
        <attr name="hideUntilContent" format="boolean" />
    </declare-styleable>
</resources>
