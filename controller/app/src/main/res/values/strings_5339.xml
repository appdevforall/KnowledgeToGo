<?xml version="1.0" encoding="utf-8"?>
<!--
  strings_5339.xml — TEMPORARY holding file for ADFA-5339 (Dashboard-update card UI).

  These strings ARE user-facing and MUST be translated. They live here, marked
  translatable="false", only so the build passes while the translations are pending: this repo
  makes MissingTranslation a lint error and translatable="false" suppresses it. Until then every
  locale shows English for these seven strings.

  MIGRATION (do before/at merge, or as the l10n follow-up): translate all seven into the 38 locales,
  move the keys into values/strings.xml (and each values-<lang>/strings.xml) WITHOUT the
  translatable flag, then DELETE this file. Android merges every <resources> in values/, so no code
  change is needed when they move.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Update-aware primary action (paired with the existing k2go_dash_rebuild). -->
    <string name="k2go_dash_update" translatable="false">Update</string>
    <!-- Version target in the subtitle, not the button (Fork B): "REST core · v1.2.7 → v1.3.0". -->
    <string name="k2go_dash_card_sub_update_fmt" translatable="false">REST core · v%1$s → v%2$s</string>
    <!-- Offline status pill. -->
    <string name="k2go_dash_no_connection" translatable="false">No connection</string>
    <!-- Cancel-the-update confirmation (Fork A). -->
    <string name="k2go_dash_cancel_confirm_title" translatable="false">Stop the update?</string>
    <string name="k2go_dash_cancel_confirm_msg" translatable="false">The dashboard stays on its current version.</string>
    <string name="k2go_dash_cancel_confirm_stop" translatable="false">Stop update</string>
    <string name="k2go_dash_cancel_confirm_keep" translatable="false">Keep updating</string>
    <!-- Versionless site refresh, in the rebuild confirm dialog (default on). Reuses k2go_maps_log_show/
         hide for the Details chevron, so no new "show/hide details" string is needed. -->
    <string name="k2go_dash_update_site" translatable="false">Update the Website</string>
    <!-- Confirm-dialog title when a newer build exists (pairs with the existing rebuild-confirm title). -->
    <string name="k2go_dash_update_confirm_title" translatable="false">Update the REST core?</string>
</resources>
