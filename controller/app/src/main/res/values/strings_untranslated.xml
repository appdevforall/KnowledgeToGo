<?xml version="1.0" encoding="utf-8"?>
<!--
  strings_untranslated.xml : WIP UI strings pending localization (K2GO l10n policy).

  This is the tracking list for strings that are user-facing but NOT yet translated to the 33
  locales. They carry translatable="false" HERE (so lint's MissingTranslation is satisfied and the
  debt is visible in one place) instead of being buried inline in strings.xml. When a string is
  translated, migrate it to strings.xml with all locale values and drop the entry here. This is the
  ONLY external string file. There are no per-feature string files; everything else lives in
  strings.xml.
-->
<resources>
    <!-- K2GO-584 prototype: the cable is plugged in, the Clone cable link has not started. -->
    <string name="k2go_clone_link_usb_present" translatable="false">Cable connected. Waiting for the Clone service to start.</string>
    <!-- K2GO-584 prototype: the cable is open, the other phone does not answer. -->
    <string name="k2go_clone_link_usb_peer_send" translatable="false">Waiting for the other phone. On it, open Clone, tap Receive and answer any USB dialog.</string>
    <string name="k2go_clone_link_usb_peer_receive" translatable="false">Waiting for the other phone. On it, open Clone > Send, go to step 3 (Copy) and answer any USB dialog.</string>
    <string name="k2go_clone_link_usb_switching" translatable="false">Cable found. Connecting to the other phone.</string>
    <string name="k2go_clone_link_usb_ask" translatable="false">Tap OK in the USB dialog on this phone.</string>
    <string name="k2go_clone_link_usb_denied" translatable="false">USB access was not allowed. Unplug the cable and plug it in again.</string>
    <!-- K2GO-584 prototype: receiver Wi-Fi row when a cable is plugged in. -->
    <string name="k2go_clone_link_not_found_cable" translatable="false">Sending phone not found on this Wi-Fi network.</string>

</resources>
