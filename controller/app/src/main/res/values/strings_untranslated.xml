<?xml version="1.0" encoding="utf-8"?>
<!--
  strings_untranslated.xml : WIP UI strings pending localization (K2GO l10n policy).

  This is the tracking list for strings that are user-facing but NOT yet translated to the 33
  locales. They carry translatable="false" HERE (so lint's MissingTranslation is satisfied and the
  debt is visible in one place) instead of being buried inline in strings.xml. When a string is
  translated, migrate it to strings.xml with all locale values and drop the entry here. This is the
  ONLY external string file. There are no per-feature string files; everything else lives in
  strings.xml.
-->
<resources>
    <!-- K2Go School (feature/k2go-school): the Class tab. -->
    <!-- Bottom bar tab and title of the Class screen. Keep it short: the bar has 5 tabs. -->
    <string name="k2go_tab_class" translatable="false">Class</string>
    <!-- Subtitle of the Class screen: what the two cards do. -->
    <string name="k2go_class_body" translatable="false">Lead a class from this phone, or follow the class on the teacher\'s phone.</string>
    <!-- Card title and button: the teacher opens the class page on this phone. -->
    <string name="k2go_class_teach" translatable="false">Teach a class</string>
    <!-- Body of the teacher card. -->
    <string name="k2go_class_teach_body" translatable="false">Open the class page of the library on this phone. The students see what you show.</string>
    <!-- Teacher card, while the app asks the library on this phone if it has the class module. -->
    <string name="k2go_class_checking" translatable="false">Checking the library on this phone...</string>
    <!-- Teacher card, when the library on this phone answers but has no class module. -->
    <string name="k2go_class_no_module" translatable="false">The class module is not installed in the library on this phone.</string>
    <!-- Teacher card, when the library on this phone does not run (it is stopped or starting). The card changes by itself when the library runs. -->
    <string name="k2go_class_no_box" translatable="false">The library on this phone does not run now. When it runs, you can teach a class here.</string>
    <!-- Card title and button: a student scans the teacher's code to follow the class. -->
    <string name="k2go_class_join" translatable="false">Join a class</string>
    <!-- Body of the student card. -->
    <string name="k2go_class_join_body" translatable="false">Connect to the network of the teacher first. Then scan the Open code on the teacher\'s Connect screen.</string>
    <!-- Prompt on the QR scanner when a student joins a class. -->
    <string name="k2go_class_scan_prompt" translatable="false">Scan the Open code on the teacher\'s Connect screen.</string>
    <!-- Message when the scanned code is not the address of a K2Go library. -->
    <string name="k2go_class_bad_code" translatable="false">This code is not the address of a K2Go library. Scan the Open code on the teacher\'s Connect screen.</string>
</resources>
