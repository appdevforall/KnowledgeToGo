<?xml version="1.0" encoding="utf-8"?>
<!--
  strings_untranslated.xml : WIP UI strings pending localization (K2GO l10n policy).

  This is the tracking list for strings that are user-facing but NOT yet translated to the 33
  locales. They carry translatable="false" HERE (so lint's MissingTranslation is satisfied and the
  debt is visible in one place) instead of being buried inline in strings.xml. When a string is
  translated, migrate it to strings.xml with all locale values and drop the entry here. This is the
  ONLY external string file. There are no per-feature string files; everything else lives in
  strings.xml.
-->
<resources>
    <!-- Dashboard card and Module management row: the box tracks a branch that is not on GitHub any more. The status pill. -->
    <string name="k2go_dash_chip_branch_missing" translatable="false">Branch not on GitHub</string>
    <!-- The same case, the card subtitle. %1$s = the branch name, for example feature/k2go-school. -->
    <string name="k2go_dash_branch_missing_fmt" translatable="false">The branch %1$s of this box is no longer on GitHub. The box keeps its current version.</string>
    <!-- Module management row subtitle on a box that is not on main. %1$s = the dash-node version, %2$s = the branch name. -->
    <string name="k2go_dash_card_sub_branch_fmt" translatable="false">REST core: installed v%1$s, branch %2$s</string>
</resources>
