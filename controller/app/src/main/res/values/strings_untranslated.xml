        <item>Organizing...</item>
        <item>Polishing...</item>
        <item>Tuning...</item>
        <item>Arranging...</item>
        <item>Setting things up...</item>
        <item>Making it yours...</item>
        <item>Almost there...</item>
    </string-array>
</resources>
