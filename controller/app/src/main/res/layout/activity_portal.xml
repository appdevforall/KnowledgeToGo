<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- WebView (Web page content handles its own background,
    but you can force a dark theme in Java using WebSettings.setForceDark) -->
    <org.iiab.controller.portal.presentation.GestureWebView
        android:id="@+id/myWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ADFA-4886: nav chrome uses Material 3 vector icons + theme attributes (system day/night)
         instead of emoji/glyph text buttons. Icon-only buttons carry a contentDescription. -->
    <!-- Collapsed-bar handle: a Material 3 tab of the bar's own surface with a drag grabber,
         so it reads as the nav bar peeking from the bottom edge rather than a separate button. -->
    <ImageButton
        android:id="@+id/btnHandle"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_nav_handle"
        android:contentDescription="@string/k2go_nav_show_bar"
        android:elevation="8dp"
        android:paddingTop="20dp"
        android:scaleType="center"
        android:tint="?attr/colorOnSurfaceVariant"
        app:srcCompat="@drawable/ic_nav_grabber" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical"
        android:visibility="invisible"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnHideNav"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/k2go_nav_hide_bar"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/ic_expand_more" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/k2go_nav_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                app:srcCompat="@drawable/ic_arrow_left" />

            <!-- ADFA-4887: repurposed as a Fullscreen toggle (no in-WebView home page anymore). -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/k2go_nav_fullscreen"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                app:srcCompat="@drawable/ic_fullscreen" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/k2go_nav_reload"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                app:srcCompat="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/btnExit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/k2go_nav_exit"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="@color/k2go_nav_exit"
                app:srcCompat="@drawable/ic_close_24" /> <!-- Red is the universal alert color -->

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/k2go_nav_forward"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                app:srcCompat="@drawable/ic_arrow_right" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
