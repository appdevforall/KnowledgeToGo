<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4842: shared per-module install/status detail, hosted inside the install index (observe
     only). Title is set to the module's name in code. A contained spinner + a status line that
     follows the module queue, plus the collapsible LogRepository terminal (the real Ansible output),
     reusing the maps "Show details" pattern. No "Run in background" — the index is the gate. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/k2go_modinst_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_mod_install_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_muted" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp">

            <ProgressBar
                android:id="@+id/k2go_modinst_anim"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/k2go_teal" />
        </FrameLayout>

        <TextView
            android:id="@+id/k2go_modinst_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink" />

        <LinearLayout
            android:id="@+id/k2go_modinst_log_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/k2go_modinst_log_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_log_show"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />

            <ImageView
                android:id="@+id/k2go_modinst_log_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/k2go_teal"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/k2go_modinst_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@color/k2go_terminal_bg">

            <TextView
                android:id="@+id/k2go_modinst_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/k2go_terminal_text"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
