<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4842: shared per-module install/status detail, hosted inside the install index (observe
     only). Title is set to the module's name in code. A contained spinner + a status line that
     follows the module queue, plus the collapsible LogRepository terminal (the real Ansible output),
     reusing the maps "Show details" pattern. No "Run in background" — the index is the gate. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/k2go_modinst_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_mod_install_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_muted" />

        <!-- ADFA-5074: shared block; the asset is chosen by ProgressVisuals. The margin is
             overridden because this card always spaced it at 16dp, not the shared 12dp —
             overriding layout attrs on an <include> requires restating width and height. -->
        <include
            layout="@layout/view_k2go_working_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- K2GO-593: the standard proot install panel: install bar + download card
             (redesign/ModuleProgressPanel). -->
        <include layout="@layout/view_k2go_module_progress" />

        <TextView
            android:id="@+id/k2go_modinst_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink" />

        <!-- ADFA-4898: Retry for a failed module is NOT here — it lives in the host's detail button bar
             (SetupProgressActivity: k2go_sp_back becomes Retry, k2go_sp_detail_finish becomes Back),
             reusing the same Run-in-background + Back template the live details already use. -->

        <!-- ADFA-4842: "this takes time" info card, matching the maps Preparing screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/k2go_info_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/k2go_mod_leave_title"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_info_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_mod_leave_body"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_info_ink" />
        </LinearLayout>

        <!-- K2GO-374: the shared live-log details panel (was a hand-rolled toggle + ScrollView). -->
        <org.appdevforall.k2go.widget.LiveLogPanel
            android:id="@+id/k2go_modinst_log_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
