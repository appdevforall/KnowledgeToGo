<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4849: ZIM category detail (screen 2). Fixed header + fixed bottom bar; only the list
     scrolls. Rows are built programmatically into k2go_zc_list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/k2go_zc_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_teal" />

        <!-- ADFA-5033: title only. The count moved to the list-controls row (below), and the language
             lives in the selector box — dropped the redundant "‹lang› · N" pill next to the title. -->
        <TextView
            android:id="@+id/k2go_zc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <!-- ADFA-5033: same one-control language selector as the catalog landing — whole box opens the
             picker (▼), no inner Change button (no button-in-button). Two lines; source in Title-Case. -->
        <LinearLayout
            android:id="@+id/k2go_zc_lang_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:background="@drawable/k2go_getmore_bg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/k2go_zc_lang_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:id="@+id/k2go_zc_lang_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/k2go_muted" />
            </LinearLayout>

            <ImageView
                android:id="@+id/k2go_zc_lang_caret"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/k2go_teal"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <EditText
            android:id="@+id/k2go_zc_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/k2go_card_bg"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink"
            android:textColorHint="@color/k2go_muted" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip android:id="@+id/k2go_zc_sort_size"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip android:id="@+id/k2go_zc_sort_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <com.google.android.material.chip.Chip android:id="@+id/k2go_zc_sort_group"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/k2go_zc_sort_group" />
        </LinearLayout>

        <!-- ADFA-5033: count on its OWN line (design board k2go-count-overflow-v1) so it never shares the
             scrollable/variable chip row — can't wrap on es/de + small screens. Right-aligned, tabular;
             live "N results" while searching. -->
        <TextView android:id="@+id/k2go_zc_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>

    <!-- Scrolling list (the only scrollable region) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/k2go_zc_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <!-- Fixed bottom bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k2go_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/k2go_zc_free"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />

        <ProgressBar
            android:id="@+id/k2go_zc_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="@color/k2go_teal"
            android:progressBackgroundTint="@color/k2go_hairline" />

        <Button
            android:id="@+id/k2go_zc_add"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:backgroundTint="@color/k2go_teal" />
    </LinearLayout>
</LinearLayout>
