<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4842: Module detail (Play Store style). A 16:9 placeholder image, title + subtitle, and a
     description of what the module is. Primary "Schedule install" banks it and returns to the hub;
     secondary "Install now" schedules it and proceeds to the install index immediately. No content
     selector (that's maps-only, later) — the description replaces it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="16dp"><!-- ADFA-5346: keep the pinned action off the bottom edge / nav bar (matches the other pinned CTAs) -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/k2go_moddet_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />

            <ImageView
                android:id="@+id/k2go_moddet_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/k2go_module_placeholder"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/k2go_moddet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/k2go_ink" />

            <TextView
                android:id="@+id/k2go_moddet_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_muted" />

            <!-- ADFA-5011: FlowLayout so the meta chips wrap to a 2nd line on narrow screens instead of
                 clipping the last pill off the right edge (same fix as ADFA-4999). -->
            <org.appdevforall.k2go.redesign.FlowLayout
                android:id="@+id/k2go_moddet_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/k2go_moddet_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/k2go_ink" />

            <LinearLayout
                android:id="@+id/k2go_moddet_includes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/k2go_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_mod_includes_title"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:id="@+id/k2go_moddet_includes_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/k2go_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/k2go_moddet_license"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_muted" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/k2go_moddet_schedule"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:backgroundTint="@color/k2go_teal" />

    <Button
        android:id="@+id/k2go_moddet_install_now"
        style="@style/Widget.K2Go.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="6dp"
        android:text="@string/k2go_mod_install_now" />
</LinearLayout>
