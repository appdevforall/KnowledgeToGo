<?xml version="1.0" encoding="utf-8"?>
<!--
  ADFA-5154: Connect redesign. The Hotspot tab shows BOTH QRs on one scrollable page (no
  vanishing wizard step) — sections (1) Join and (2) Open, always present, with a "STEP 2 BELOW"
  hint and a peeking (2) on small screens. The segmented tabs are pinned OUTSIDE the scroll
  (sticky chrome); only the middle scrolls. Wi-Fi and the failed / no-system states use a single
  container. See ConnectFragment. Wi-Fi tab layout is unchanged in spirit (single QR).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/k2go_paper">

    <!-- ===== PINNED HEADER: title + subtitle + segmented tabs (do not scroll) ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="16dp" android:paddingBottom="8dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/k2go_tab_connect" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="@color/k2go_ink" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/k2go_connect_subtitle" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="@color/k2go_muted" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="16dp" android:background="@drawable/k2go_card_bg" android:padding="4dp">
            <TextView android:id="@+id/k2go_conn_hotspot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="8dp"
                android:gravity="center" android:text="@string/k2go_hotspot" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/k2go_conn_wifi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="8dp"
                android:gravity="center" android:text="@string/k2go_wifi" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== SCROLLABLE MIDDLE (only this scrolls; visible scrollbar for discoverability) ===== -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="vertical" android:scrollbarStyle="outsideOverlay">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="16dp">

            <!-- 1·2 stepper for orientation (kept per spec). Built by the fragment. -->
            <LinearLayout android:id="@+id/k2go_conn_steps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical" />

            <!-- ========== TWO-SECTION (Hotspot): (1) Join stacked over (2) Open ========== -->
            <LinearLayout android:id="@+id/k2go_conn_two" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <!-- Section (1) Join -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="12dp" android:padding="16dp" android:background="@drawable/k2go_card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/k2go_badge_teal"
                            android:gravity="center" android:text="1" android:textColor="@color/k2go_on_teal" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="@string/k2go_connect_s1_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/k2go_ink" />
                    </LinearLayout>
                    <FrameLayout android:id="@+id/k2go_conn_qr1_frame" android:layout_width="242dp" android:layout_height="242dp"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/k2go_card_bg">
                        <ImageView android:id="@+id/k2go_conn_qr1" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:padding="10dp" android:contentDescription="@string/k2go_connect_s1_title" />
                        <TextView android:id="@+id/k2go_conn_qr1_ph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:gravity="center" android:padding="12dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/k2go_muted" android:visibility="gone" />
                    </FrameLayout>
                    <TextView android:id="@+id/k2go_conn_caption1" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/k2go_ink" />
                    <TextView android:id="@+id/k2go_conn_subcaption1" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal" />
                    <TextView android:id="@+id/k2go_conn_fallback_toggle1" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="6dp" android:padding="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal"
                        android:clickable="true" android:focusable="true" android:visibility="gone" />
                    <LinearLayout android:id="@+id/k2go_conn_fallback1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginTop="8dp" android:visibility="gone">
                        <LinearLayout android:id="@+id/k2go_conn_fallback_values1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- "STEP 2 BELOW ⌄" hint (passive cue; the fragment shows it once the sections are live) -->
                <LinearLayout android:id="@+id/k2go_conn_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginTop="16dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/k2go_connect_step2_below" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/k2go_teal" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⌄" android:textColor="@color/k2go_teal" android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <!-- Section (2) Open -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/k2go_card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/k2go_badge_teal"
                            android:gravity="center" android:text="2" android:textColor="@color/k2go_on_teal" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="@string/k2go_connect_s2_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/k2go_ink" />
                    </LinearLayout>
                    <FrameLayout android:id="@+id/k2go_conn_qr2_frame" android:layout_width="242dp" android:layout_height="242dp"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/k2go_card_bg">
                        <ImageView android:id="@+id/k2go_conn_qr2" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:padding="10dp" android:contentDescription="@string/k2go_connect_s2_title" />
                        <TextView android:id="@+id/k2go_conn_qr2_ph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:gravity="center" android:padding="12dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/k2go_muted" android:visibility="gone" />
                    </FrameLayout>
                    <TextView android:id="@+id/k2go_conn_caption2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/k2go_ink" />
                    <TextView android:id="@+id/k2go_conn_subcaption2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal" />
                    <TextView android:id="@+id/k2go_conn_fallback_toggle2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="6dp" android:padding="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal"
                        android:clickable="true" android:focusable="true" android:visibility="gone" />
                    <LinearLayout android:id="@+id/k2go_conn_fallback2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginTop="8dp" android:visibility="gone">
                        <LinearLayout android:id="@+id/k2go_conn_fallback_values2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ========== SINGLE container: Wi-Fi (single QR), plus failed / no-system status ========== -->
            <LinearLayout android:id="@+id/k2go_conn_single" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <FrameLayout android:id="@+id/k2go_conn_qrS_frame" android:layout_width="242dp" android:layout_height="242dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:background="@drawable/k2go_card_bg">
                    <ImageView android:id="@+id/k2go_conn_qrS" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:padding="10dp" android:contentDescription="@string/k2go_tab_connect" />
                    <TextView android:id="@+id/k2go_conn_qrS_ph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:gravity="center" android:padding="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/k2go_muted" android:visibility="gone" />
                </FrameLayout>
                <TextView android:id="@+id/k2go_conn_captionS" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/k2go_ink" />
                <TextView android:id="@+id/k2go_conn_subcaptionS" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal" />
                <TextView android:id="@+id/k2go_conn_fallback_toggleS" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="6dp" android:padding="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_teal"
                    android:clickable="true" android:focusable="true" android:visibility="gone" />
                <LinearLayout android:id="@+id/k2go_conn_fallbackS" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="8dp" android:visibility="gone">
                    <LinearLayout android:id="@+id/k2go_conn_fallback_valuesS" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
                <!-- Repurposed as the Recover CTA in the no-system state (ADFA-5150). -->
                <TextView android:id="@+id/k2go_conn_advance" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:padding="16dp" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:clickable="true" android:focusable="true" android:visibility="gone" />
            </LinearLayout>

            <!-- ===== shared bottom: Done + "available while open" footer ===== -->
            <TextView android:id="@+id/k2go_conn_finish" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:padding="16dp" android:gravity="center" android:text="@string/k2go_done"
                android:background="@drawable/k2go_primary_bg" android:textColor="@color/k2go_on_teal"
                android:textAppearance="?attr/textAppearanceTitleLarge" android:clickable="true" android:focusable="true" android:visibility="gone" />
            <!-- ADFA-5236: "Available while the app is open." removed from the Connect footer. -->
            <TextView android:id="@+id/k2go_conn_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="10dp" android:text="@string/k2go_connect_available"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/k2go_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
