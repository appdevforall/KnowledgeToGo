<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_k2go_help.xml (K2GO-406): in-app manual viewer. A Material 3 top bar (back + "Help"
  title) over a WebView that serves the bundled Help and Manual site via WebViewAssetLoader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/k2go_help_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <WebView
        android:id="@+id/k2go_help_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
