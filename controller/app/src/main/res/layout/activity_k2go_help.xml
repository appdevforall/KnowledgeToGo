<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_k2go_help.xml (K2GO-406): in-app manual viewer. The unified Settings header (back glyph +
  "Help" title) over a WebView that serves the bundled Help and Manual site via WebViewAssetLoader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/k2go_paper"
    android:fitsSystemWindows="true">

    <org.appdevforall.k2go.ui.K2GoHeaderView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:k2goTitle="@string/k2go_settings_help" />

    <WebView
        android:id="@+id/k2go_help_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
