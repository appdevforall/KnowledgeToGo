<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-553: "Preparing system" boot screen. Replaces the boot gate for a boot that makes the
     per-box values. Themed surface (not the gate's fixed paper); the Lottie is text-free and the
     words are composited here. Driven by boxidentity/presentation/PreparingSystemScreen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/k2go_preparing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:visibility="gone">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/k2go_preparing_anim"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/k2go_preparing_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/k2go_preparing_headline"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <!-- The word slides inside this slot; the frame clips it so it appears from below and leaves upward. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/k2go_preparing_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="none"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorPrimary" />
    </FrameLayout>
</LinearLayout>
