<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: delete progress. Shows the overall progress (settled-item count) plus the item in
     flight, then a settled state (done or partial) with Retry / Finish. Delete is atomic per item,
     so the item bar is indeterminate while a delete runs, not a byte ratio. The content scrolls; the
     action row is pinned at the bottom so Cancel never scrolls away. Material 3 tokens; no hardcoded
     colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/k2go_cxd_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/k2go_ink"
                android:text="@string/k2go_cx_delete_title" />

            <!-- K2GO-376: delete animation (content -> shredder loop). The loop draws the shredder on the
                 right; this overlay composites the K2Go logo (the library, the source) on the left, on the
                 same grid as the import overlay. Shown only while deleting; reduce-motion holds a frame. -->
            <FrameLayout
                android:id="@+id/k2go_cxd_anim_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/k2go_cxd_anim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="940"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="360"
                            android:src="@drawable/ic_launcher_foreground" android:scaleType="centerCrop" android:contentDescription="@null" />
                        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="640" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Overall -->
            <TextView
                android:id="@+id/k2go_cxd_overall_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_ink" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/k2go_cxd_overall_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:trackThickness="8dp"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/k2go_cxd_overall_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_muted" />

            <!-- Current item -->
            <TextView
                android:id="@+id/k2go_cxd_item_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxLines="2"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_ink" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/k2go_cxd_item_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp" />

            <!-- Settled message (done / partial / error) -->
            <TextView
                android:id="@+id/k2go_cxd_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/k2go_ink"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned action row: anchored at the bottom so Cancel never scrolls away as the content grows.
         Cancel keeps its destructive styling; Retry / Finish appear in the settled state. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/k2go_cxd_cancel"
            style="@style/Widget.K2Go.Button.Text.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/k2go_dash_cancel" />

        <Button
            android:id="@+id/k2go_cxd_retry"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:text="@string/k2go_cx_delete_retry" />

        <Button
            android:id="@+id/k2go_cxd_finish"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="@string/k2go_cx_delete_finish" />
    </LinearLayout>
</LinearLayout>
