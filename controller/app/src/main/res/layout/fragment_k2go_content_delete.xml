<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: delete progress. Shows the overall progress (settled-item count) plus the item in
     flight, then a settled state (done or partial) with Retry / Finish. Delete is atomic per item,
     so the item bar is indeterminate while a delete runs, not a byte ratio. Material 3 tokens; no
     hardcoded colours. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/k2go_cxd_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/k2go_ink"
            android:text="@string/k2go_cx_delete_title" />

        <!-- Overall -->
        <TextView
            android:id="@+id/k2go_cxd_overall_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/k2go_ink" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/k2go_cxd_overall_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/k2go_cxd_overall_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />

        <!-- Current item -->
        <TextView
            android:id="@+id/k2go_cxd_item_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:maxLines="2"
            android:ellipsize="middle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/k2go_cxd_item_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            app:trackThickness="6dp"
            app:trackCornerRadius="3dp" />

        <!-- Settled message (done / partial / error) -->
        <TextView
            android:id="@+id/k2go_cxd_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/k2go_ink"
            android:visibility="gone" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/k2go_cxd_cancel"
                style="@style/Widget.K2Go.Button.Text.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/k2go_dash_cancel" />

            <Button
                android:id="@+id/k2go_cxd_retry"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:text="@string/k2go_cx_delete_retry" />

            <Button
                android:id="@+id/k2go_cxd_finish"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/k2go_cx_delete_finish" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
