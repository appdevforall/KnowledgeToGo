<?xml version="1.0" encoding="utf-8"?>
<!-- K2Go School: the Class tab (school/presentation/ClassFragment). Header as on Connect and Clone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k2go_paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/k2go_tab_class"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_class_body"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- Teacher: only when this phone's box serves the class pages. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k2go_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_class_teach"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/k2go_class_teach_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted" />

                <TextView
                    android:id="@+id/k2go_class_teach_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_checking"
                    android:textAppearance="@style/TextAppearance.K2Go.Label"
                    android:textColor="@color/k2go_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_teach"
                    style="@style/Widget.K2Go.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/k2go_class_teach" />
            </LinearLayout>

            <!-- Two ways in: teach, or join. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/k2go_hairline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/k2go_class_or"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/k2go_hairline" />
            </LinearLayout>

            <!-- Student: the classes that teacher boxes announce on the Wi-Fi. The card keeps its size
                 for any number of classes: one class has its own Join button, two or more open
                 "Choose a class" (ClassFragment). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k2go_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_class_join"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:id="@+id/k2go_class_find_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/k2go_class_finding"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted" />

                <!-- One class only: how long ago it started. -->
                <TextView
                    android:id="@+id/k2go_class_one_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/k2go_class_searching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_search_again"
                    style="@style/Widget.K2Go.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_search_again"
                    android:visibility="gone" />

                <!-- "Join class LLGU" (one class) or "Choose a class" (two or more). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_join_button"
                    style="@style/Widget.K2Go.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Hidden for now: the class list is the only join path. The scan path has no
                     class screen support yet. Its code stays for the later QR work. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_join"
                    style="@style/Widget.K2Go.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_scan"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
