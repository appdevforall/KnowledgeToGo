<?xml version="1.0" encoding="utf-8"?>
<!-- K2Go School: the Class tab (school/presentation/ClassFragment). Header as on Connect and Clone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k2go_paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/k2go_tab_class"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_class_body"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- Teacher: only when this phone's box serves the class pages. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k2go_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_class_teach"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/k2go_class_teach_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted" />

                <TextView
                    android:id="@+id/k2go_class_teach_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_checking"
                    android:textAppearance="@style/TextAppearance.K2Go.Label"
                    android:textColor="@color/k2go_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_teach"
                    style="@style/Widget.K2Go.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/k2go_class_teach" />
            </LinearLayout>

            <!-- Student: the classes that teacher boxes announce on the Wi-Fi; the scan of the
                 teacher's Connect "Open" code stays as the fallback. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k2go_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_class_join"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/k2go_class_join_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/k2go_muted" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/k2go_class_searching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/k2go_class_find_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_finding"
                    android:textAppearance="@style/TextAppearance.K2Go.Label"
                    android:textColor="@color/k2go_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_search_again"
                    style="@style/Widget.K2Go.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_search_again"
                    android:visibility="gone" />

                <!-- One button per class found (item_k2go_class_found), filled in code. -->
                <LinearLayout
                    android:id="@+id/k2go_class_found"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/k2go_class_join"
                    style="@style/Widget.K2Go.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k2go_class_scan" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
