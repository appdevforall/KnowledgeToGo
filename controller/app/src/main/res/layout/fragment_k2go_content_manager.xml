<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: content manager (gestor). A RecyclerView lists managed content grouped by app, each
     item with its size (recycled rows: a large library must not inflate one view per item). The
     header block (title + subtitle + storage summary) and the per-app group headers are row types in
     the same list. The bottom action bar (Export / Share / Delete) is present but disabled in this
     slice: the actions are later slices. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/k2go_cx_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/k2go_teal" />

    <!-- Import starts from a drive, not from on-box content, so it is a top-level action separate from
         the per-item selection below. Always visible. -->
    <Button
        android:id="@+id/k2go_cx_import"
        style="@style/Widget.K2Go.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="4dp"
        android:text="@string/k2go_cx_import_from_drive" />

    <TextView
        android:id="@+id/k2go_cx_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/k2go_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/k2go_cx_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />

    <!-- Bottom action bar: shown when at least one item is selected. Disabled in this slice. -->
    <LinearLayout
        android:id="@+id/k2go_cx_actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/k2go_surface"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/k2go_cx_selection_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/k2go_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/k2go_cx_export"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_export" />

            <Button
                android:id="@+id/k2go_cx_share"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_share" />

            <Button
                android:id="@+id/k2go_cx_delete"
                style="@style/Widget.K2Go.Button.Text.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/k2go_cx_action_delete" />
        </LinearLayout>

        <TextView
            android:id="@+id/k2go_cx_stub_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/k2go_cx_actions_pending"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>
</LinearLayout>
