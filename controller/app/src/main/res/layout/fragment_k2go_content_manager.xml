<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: content manager (gestor). Lists managed content grouped by app, each item with its
     size, plus a total used and the free disk, with per-item multi-select. The bottom action bar
     (Export / Share / Delete) is present but disabled in this slice: the actions are later slices.
     Rows are built programmatically into k2go_cx_cards, like the module hub. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/k2go_cx_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_cx_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/k2go_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_cx_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/k2go_muted" />

            <!-- Storage summary (total used + free disk): filled in code so it can hide the free
                 figure when /v1/storage is not reachable yet. -->
            <LinearLayout
                android:id="@+id/k2go_cx_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

            <!-- LOADING / ERROR / EMPTY one-liner. -->
            <TextView
                android:id="@+id/k2go_cx_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/k2go_muted"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/k2go_cx_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action bar: shown when at least one item is selected. Disabled in this slice. -->
    <LinearLayout
        android:id="@+id/k2go_cx_actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/k2go_surface"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/k2go_cx_selection_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/k2go_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/k2go_cx_export"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_export" />

            <Button
                android:id="@+id/k2go_cx_share"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_share" />

            <Button
                android:id="@+id/k2go_cx_delete"
                style="@style/Widget.K2Go.Button.Text.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/k2go_cx_action_delete" />
        </LinearLayout>

        <TextView
            android:id="@+id/k2go_cx_stub_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/k2go_cx_actions_pending"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>
</LinearLayout>
