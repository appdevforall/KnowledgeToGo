<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: content manager (gestor). A RecyclerView lists managed content grouped by app, each
     item with its size (recycled rows: a large library must not inflate one view per item). The
     header block (title + subtitle + storage summary) and the per-app category headers are row types
     in the same list; a category header is a tonal band that dominates its items and toggles them
     (accordion). The entry actions (Import, Receive) and the selection action bar (Export / Share /
     Delete) are pinned below the list, never inside the scroll, so content rows never hide them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/k2go_cx_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/k2go_teal" />

    <!-- Loading / error message. Shown in place of the list (weighted like it), so the pinned bottom
         bars stay at the bottom while content is loading or unavailable. -->
    <TextView
        android:id="@+id/k2go_cx_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/k2go_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/k2go_cx_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />

    <!-- Entry actions: pinned below the list, always visible. Import reads a drive and Receive pulls
         from a paired sender, so both start from outside the on-box content (not from the selection). -->
    <LinearLayout
        android:id="@+id/k2go_cx_entrybar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/k2go_surface"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/k2go_cx_import"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k2go_cx_import_from_drive" />

        <Button
            android:id="@+id/k2go_cx_receive"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/k2go_cx_receive_from_network" />
    </LinearLayout>

    <!-- Selection action bar: shown when at least one item is selected. -->
    <LinearLayout
        android:id="@+id/k2go_cx_actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/k2go_surface"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/k2go_cx_selection_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/k2go_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- maxLines=1 + autosize: the label shrinks to fit the third-width slot (down to ~20% from
                 14sp) instead of wrapping to two lines; the outlined pair also trims its horizontal
                 padding a little so a word like "Compartir" keeps its size on most screens. M3-compliant. -->
            <Button
                android:id="@+id/k2go_cx_export"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="1sp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_export" />

            <Button
                android:id="@+id/k2go_cx_share"
                style="@style/Widget.K2Go.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="1sp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_share" />

            <Button
                android:id="@+id/k2go_cx_delete"
                style="@style/Widget.K2Go.Button.Text.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="1sp"
                android:enabled="false"
                android:text="@string/k2go_cx_action_delete" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
