<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427: import progress. Shows the overall and current-item progress (bar / percent / bytes /
     speed / ETA) while the foreground service reads from the drive and the box ingests each item, then
     a settled state (done or partial) with Retry / Finish. The content scrolls; the action row is
     pinned at the bottom so Cancel never scrolls away. Material 3 tokens; no hardcoded colours.
     Mirrors fragment_k2go_content_export. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/k2go_cxi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/k2go_ink"
                android:text="@string/k2go_cx_import_title" />

            <TextView
                android:id="@+id/k2go_cxi_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_muted" />

            <!-- K2GO-427: transfer animation. Wi-Fi receive plays the two-phones Clone loop (ADFA-5143) with
                 both logos; a drive import plays the microSD loop, which draws the card on the left, so the
                 fragment hides the left logo (K2GO-376). The loops ship without the K2Go logo: this overlay
                 composites it. Shown only while the transfer runs; reduce-motion holds a frame. -->
            <FrameLayout
                android:id="@+id/k2go_cxi_anim_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/k2go_cxi_anim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="940"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/k2go_cxi_anim_logo_left"
                            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="360"
                            android:src="@drawable/ic_launcher_foreground" android:scaleType="centerCrop" android:contentDescription="@null" />
                        <Space android:id="@+id/k2go_cxi_anim_gap"
                            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="280" />
                        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="360"
                            android:src="@drawable/ic_launcher_foreground" android:scaleType="centerCrop" android:contentDescription="@null" />
                        <Space android:id="@+id/k2go_cxi_anim_edge"
                            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Overall -->
            <TextView
                android:id="@+id/k2go_cxi_overall_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_ink" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/k2go_cxi_overall_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:trackThickness="8dp"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/k2go_cxi_overall_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_muted" />

            <!-- Current item -->
            <TextView
                android:id="@+id/k2go_cxi_item_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxLines="2"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_ink" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/k2go_cxi_item_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp" />

            <!-- Settled message (done / partial / error) -->
            <TextView
                android:id="@+id/k2go_cxi_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/k2go_ink"
                android:visibility="gone" />

            <!-- Full success: countdown to the Library, with Cancel to stay (mirrors the setup screen). -->
            <TextView
                android:id="@+id/k2go_cxi_redirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_leaf"
                android:visibility="gone" />

            <TextView
                android:id="@+id/k2go_cxi_redirect_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/k2go_setup_cancel"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned action row: anchored at the bottom so Cancel never scrolls away as the content grows.
         Cancel keeps its destructive styling; Retry / Finish appear in the settled state. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/k2go_cxi_cancel"
            style="@style/Widget.K2Go.Button.Text.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/k2go_dash_cancel" />

        <Button
            android:id="@+id/k2go_cxi_retry"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:text="@string/k2go_cx_export_retry" />

        <Button
            android:id="@+id/k2go_cxi_finish"
            style="@style/Widget.K2Go.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="@string/k2go_cx_export_finish" />
    </LinearLayout>
</LinearLayout>
