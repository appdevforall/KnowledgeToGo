<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4853: Finishing setup. Index (status dot + rows) + a detail host for the real cards.
     Buttons are real <Button> (MaterialButton under Theme.K2Go) so they match the installer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k2go_paper">

    <ScrollView
        android:id="@+id/k2go_sp_index"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k2go_setup_progress_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/k2go_ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/k2go_sp_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/k2go_dot" />

                <TextView
                    android:id="@+id/k2go_sp_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k2go_setup_starting"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/k2go_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/k2go_sp_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/k2go_sp_redirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/k2go_setup_redirect"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_leaf"
                android:visibility="gone" />

            <TextView
                android:id="@+id/k2go_sp_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/k2go_setup_cancel"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/k2go_sp_finish"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/k2go_zim_finish"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/k2go_teal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/k2go_sp_finish_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/k2go_setup_finish_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_muted"
                android:visibility="gone" />

            <Button
                android:id="@+id/k2go_sp_runbg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/k2go_zim_run_bg"
                android:textColor="@color/k2go_teal"
                android:textAllCaps="false"
                android:background="@drawable/k2go_getmore_bg"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/k2go_sp_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/k2go_paper"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/k2go_sp_fraghost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/k2go_sp_back"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/k2go_setup_back"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/k2go_teal" />

            <Button
                android:id="@+id/k2go_sp_detail_finish"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/k2go_zim_finish"
                android:textColor="@color/k2go_teal"
                android:textAllCaps="false"
                android:background="@drawable/k2go_getmore_bg" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
