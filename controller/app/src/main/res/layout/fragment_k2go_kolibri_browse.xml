<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4954: Courses picker, following CATALOG_BROWSE_TEMPLATE.md.

     The template's shape is a category index followed by an item list. The chip row's theme
     groups are an artificial grouping we author ourselves (as KiwixGroups does for ZIM) and
     are not defined yet, so the row holds only All and this screen is the item list. The
     language filters from the selector, not from a chip. Every other agreement holds:
     language selector as one whole-row control,
     flat rows with hairlines, leading checkbox, right-aligned size, count on its own line,
     one fixed bottom bar. Rows and chips are added at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/k2go_kbrowse_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_teal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_gm_courses_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <!-- One whole-row control. The box opens the picker; there is no inner button. -->
        <LinearLayout
            android:id="@+id/k2go_kbrowse_lang_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="@drawable/k2go_getmore_bg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/k2go_kbrowse_lang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/k2go_ink" />

                <TextView
                    android:id="@+id/k2go_kbrowse_lang_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/k2go_muted" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/k2go_teal"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Same field as the ZIM screens: k2go_card_bg (muted surface, 18dp), not the
             chip background, which is solid teal and turns the field into a button. -->
        <EditText
            android:id="@+id/k2go_kbrowse_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/k2go_card_bg"
            android:hint="@string/k2go_zim_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink"
            android:textColorHint="@color/k2go_muted" />

        <!-- One horizontally-scrollable line, never wraps: All + one chip per theme group.

             GONE on purpose. The theme groups are not authored yet, so the row would hold
             nothing but `All` — a second line of pills that filters nothing, competing with
             the sort toggles right below it for the same visual weight. Flip this single
             attribute to `visible` when KolibriGroups exists; the code that fills the row
             is live and needs no change. -->
        <HorizontalScrollView
            android:id="@+id/k2go_kbrowse_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/k2go_kbrowse_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Sort toggles, mutually exclusive, flat (one item per row). `Grouped` is
             deliberately absent: it is the collapse-variants view, and Kolibri channels
             have no variants to collapse. Tapping the active one reverses it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/k2go_kbrowse_sort_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/k2go_kbrowse_sort_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <!-- Count on its own line so it can never share the scrollable chip row. -->
        <TextView
            android:id="@+id/k2go_kbrowse_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/k2go_kbrowse_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/k2go_muted"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/k2go_kbrowse_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <!-- Fixed bottom bar, same shape as the ZIM item list: storage line, thin bar,
         then the forward action. Storage is context, not a hero. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k2go_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/k2go_kbrowse_storage_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />

        <ProgressBar
            android:id="@+id/k2go_kbrowse_storage_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/k2go_teal"
            android:progressBackgroundTint="@color/k2go_hairline" />

        <Button
            android:id="@+id/k2go_kbrowse_review"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/k2go_teal"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
