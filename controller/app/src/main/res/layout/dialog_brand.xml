<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    app:cardBackgroundColor="@color/dash_module_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- K2GO-385: optional leading state icon (e.g. a clay error icon) beside the title. The icon is
             GONE unless BrandDialog.setIcon is called, so dialogs without one are unchanged. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/brand_dialog_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/brand_dialog_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/dash_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/brand_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/dash_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/brand_dialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- ADFA-5346 / K2GO-385: dialog buttons use the one app-wide button system (filled primary,
             text secondaries) so they share the stadium shape, ripple and type with every other button.
             The DESTRUCTIVE red is applied in code (BrandDialog) as a tint on the filled button. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brand_dialog_positive"
            style="@style/Widget.K2Go.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/brand_dialog_negative"
            style="@style/Widget.K2Go.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- K2GO-385: the neutral slot is the tertiary action (muted), and it sits LAST so it never
             competes with the primary or the secondary above it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brand_dialog_neutral"
            style="@style/Widget.K2Go.Button.Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
