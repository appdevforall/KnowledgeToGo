<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k2go_paper">

    <!-- ADFA-4799: rail (leading) + content. The rail is shown and the bottom bar hidden in
         medium/expanded (>= 600dp wide); the reverse in compact. Toggled at runtime by width in
         LibraryActivity, so rotation never recreates the activity (the boot gate is preserved). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/k2go_nav_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/k2go_paper"
            android:visibility="gone"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:menuGravity="center"
            app:itemIconTint="@color/k2go_nav_item"
            app:itemTextColor="@color/k2go_nav_item"
            app:menu="@menu/bottom_nav_k2go" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/k2go_nav_host"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/k2go_bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/k2go_paper"
                app:elevation="0dp"
                app:labelVisibilityMode="labeled"
                app:itemIconTint="@color/k2go_nav_item"
                app:itemTextColor="@color/k2go_nav_item"
                app:menu="@menu/bottom_nav_k2go" />
        </LinearLayout>
    </LinearLayout>

    <!-- Boot gate: covers the ~5-6s server boot; entry loop then OPEN flip. -->
    <!-- ADFA-4814: fitCenter + horizontal padding so the intro/outro isn't jammed into the
         corners. Background matches the animation's own BG (#FBF8F3 in both themes) so the
         margin reads as continuous. -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/k2go_boot_gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/k2go_boot_bg"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="fitCenter" />

    <!-- Install progress over the boot gate: stays until the install actually finishes. -->
    <LinearLayout
        android:id="@+id/k2go_install_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:elevation="13dp"
        android:background="@color/k2go_boot_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/k2go_install_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_boot_ink" />

        <ProgressBar
            android:id="@+id/k2go_install_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressTint="@color/k2go_boot_accent"
            android:progressBackgroundTint="@color/k2go_boot_track" />

        <!-- ADFA-4910: extract % on its own fixed line (below the bar, above the changing
             file name) so the number never dances as the file name grows/shrinks.
             ADFA-5118: two weighted columns so the ETA can change width without shoving the
             % — % end-aligned against the centre line, ETA start-aligned after it. start/end
             (not left/right) keep it correct under RTL. No bold, to match the download line. -->
        <LinearLayout
            android:id="@+id/k2go_install_percent_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/k2go_install_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="end"
                android:minLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_boot_ink" />
            <TextView
                android:id="@+id/k2go_install_eta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="8dp"
                android:gravity="start"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_boot_muted" />
        </LinearLayout>

        <!-- ADFA-4895: a table per line, sized to the line. Two figures use the two-column row
             above (the IPv4/IPv6 probe: % + which test; verify and extract: % + estimate). Once
             the transfer starts there are three, and forcing them through a two-column row left
             them visibly off-balance. Each column is fixed, so the % cannot be moved by a rate
             swinging between "412KiB/s" and "37MiB/s". Only one of the two rows is ever shown. -->
        <LinearLayout
            android:id="@+id/k2go_download_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/k2go_download_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_boot_ink" />
            <TextView
                android:id="@+id/k2go_download_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_boot_muted" />
            <TextView
                android:id="@+id/k2go_download_eta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="8dp"
                android:gravity="start"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_boot_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/k2go_install_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_boot_muted" />

        <!-- ADFA-5119: the two controls that end the wait. The first carries three labels one at a
             time (Pause / Resume / Retry) because all three mean the same thing to the user — keep
             this download — and only the current state decides which word is true. Cancel is the
             other decision: give up the transfer AND the tier/wishlist choice behind it, which is
             why it is the one that asks for confirmation.

             Colour comes from the boot tokens, not the theme: this surface is deliberately a fixed
             light paper in both modes (see ADFA-4814 above), so ?attr/colorPrimary would be tuned
             for a dark background in night mode and land unreadable here. Same reason the labels
             above use k2go_boot_ink / k2go_boot_muted. -->
        <LinearLayout
            android:id="@+id/k2go_dl_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/k2go_dl_toggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="132dp"
                android:textColor="@color/k2go_boot_ink"
                app:strokeColor="@color/k2go_boot_ink"
                app:rippleColor="@color/k2go_boot_muted" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/k2go_dl_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/k2go_dl_cancel"
                android:textColor="@color/k2go_boot_muted"
                app:rippleColor="@color/k2go_boot_muted" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
