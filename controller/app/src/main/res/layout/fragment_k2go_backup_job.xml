<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4961: backup / restore operation screen, styled as a compact copy of the module-install
     template (fragment_k2go_module_install): title + subtitle, the shared "working" Lottie with the
     app logo composited on top, a fixed 2-line status line, the "this takes time" info card, and a
     collapsible log (GONE for now — reactivate when tar/extract output is plumbed). Adds a Finish
     button (the module index owns navigation there; here the screen does). Driven by
     DeepOpProgressRepository via BackupJobFragment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/k2go_bj_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:id="@+id/k2go_bj_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_muted" />

        <!-- Same "working" Lottie as module install; the app logo is composited on top via a weighted
             scaffold (the animation ships without a logo). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- ADFA-4961: the mode-specific loop (backup / restore) is set in code; the app logo is
                 composited on top by the scaffold below (not baked into the animation). -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/k2go_bj_anim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="300" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="480"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="680" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="295"
                        android:src="@drawable/ic_launcher_foreground"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="25" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="220" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/k2go_bj_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink" />

        <!-- K2GO-372: determinate progress for backup/restore. A restore streams the archive twice
             (safety listing, then extraction) and both passes reported nothing, so a multi-minute
             wait was indistinguishable from a hang. Gone until the op reports a real percent, so a
             phase that cannot measure itself keeps the animation above rather than a bar stuck at 0.
             Matches the module-install and maps Preparing screens. -->
        <LinearLayout
            android:id="@+id/k2go_bj_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/k2go_bj_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                app:trackCornerRadius="4dp"
                android:max="100" />

            <!-- K2GO-384: the % and the per-pass ETA sit on their own line BELOW the full-width bar
                 (mirrors the module-install / maps Preparing rows) so the ETA never shortens the bar.
                 ETA reuses the install screens' EtaText; blank when the pass can't estimate yet. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/k2go_bj_progress_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/k2go_muted" />

                <TextView
                    android:id="@+id/k2go_bj_progress_eta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/k2go_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- "this takes time" info card, matching the module install / maps Preparing screens. -->
        <LinearLayout
            android:id="@+id/k2go_bj_wait_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/k2go_info_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/k2go_bj_wait_title"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_info_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_bj_wait_body"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_info_ink" />
        </LinearLayout>

        <!-- ADFA-4961: collapsible detailed log — GONE until tar/extract output is plumbed (see ticket). -->
        <LinearLayout
            android:id="@+id/k2go_bj_log_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_log_show"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/k2go_bj_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@color/k2go_terminal_bg">

            <TextView
                android:id="@+id/k2go_bj_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/k2go_terminal_text"
                android:textIsSelectable="true" />
        </ScrollView>

        <!-- Terminal action: the module index owns this navigation; here the screen does. GONE until done.
             A styled TextView-as-button (like Clone's) so the custom background isn't overridden by
             MaterialButton's backgroundTint. -->
        <Button
            android:id="@+id/k2go_bj_finish"
            style="@style/Widget.K2Go.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:text="@string/k2go_bj_finish"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
