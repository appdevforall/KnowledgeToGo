<?xml version="1.0" encoding="utf-8"?>
<!-- K2Go School: one class in the "Choose a class" table: the ID, then the name (gone when the class
     has none) over the start ("2 minutes ago"), and on a phone of a school the school check. A tap
     joins; a class that is not from a teacher of this school is grey and does not join. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/k2go_class_row_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:minWidth="80dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/k2go_ink"
        android:textDirection="ltr" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/k2go_class_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:id="@+id/k2go_class_row_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted" />

        <TextView
            android:id="@+id/k2go_class_row_trust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/k2go_muted"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/k2go_class_row_go"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/k2go_muted" />
</LinearLayout>
