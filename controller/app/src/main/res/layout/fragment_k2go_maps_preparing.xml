<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4848 (slice 3): Maps Preparing. A CONTAINED placeholder spinner (independent of the
     boot/close Lottie) in a small band, plus a single status line that mirrors what the
     background process is doing (like the boot screen shows the current service). No invented
     progress bar. Mock text until the REST/Ansible backend feeds real output. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k2go_maps_preparing_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_maps_preparing_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_muted" />

        <!-- ADFA-4910: real "working" Lottie (cloud -> streaming dots -> logo) in place of the
             placeholder spinner. The animation ships WITHOUT the logo (see SPEC); the K2Go
             launcher foreground is composited on top, over the built-in green glow, positioned by
             a weighted scaffold so it tracks the art at any width. adjustViewBounds locks the
             600:368 ratio; Lottie falls back to a static first frame when system animations are off. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/k2go_prep_anim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:lottie_rawRes="@raw/k2go_working_loop"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <!-- Logo overlay (fills the art rect). The weights are the knobs: vertical
                 top/logo/bottom and horizontal left/logo/right center the logo at ~0.80W / 0.54H,
                 sized to sit over the green glow. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="300" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="480"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="650" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="295"
                        android:src="@drawable/ic_launcher_foreground"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="55" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="220" />
            </LinearLayout>
        </FrameLayout>

        <!-- The process's own text, not an invented percentage. -->
        <TextView
            android:id="@+id/k2go_prep_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/k2go_maps_phase_prepared"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/k2go_ink" />

        <!-- ADFA-4900: informational note (not a button). Uses the wizard info-card background
             (k2go_info_bg), matching ZIM Preparing, so it no longer reads as a second button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/k2go_info_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_leave_title"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_teal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_maps_leave_body"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_teal" />
        </LinearLayout>

        <!-- ADFA-4901: collapsible live log fed by LogRepository (the reusable terminal for all
             proot module installs). Hidden by default; the status line above shows the latest line.
             ADFA-4910: rendered as a tappable text + chevron (NOT a second outlined button next to
             "Run in background"), matching the clone/connect hint style. Tapping reveals the
             terminal; toggleLog() swaps the label and rotates the chevron. -->
        <LinearLayout
            android:id="@+id/k2go_prep_log_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/k2go_prep_log_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_log_show"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />

            <ImageView
                android:id="@+id/k2go_prep_log_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/k2go_teal"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/k2go_prep_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@color/k2go_terminal_bg">

            <TextView
                android:id="@+id/k2go_prep_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/k2go_terminal_text"
                android:textIsSelectable="true" />
        </ScrollView>

        <Button
            android:id="@+id/k2go_prep_run_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/k2go_maps_run_bg"
            android:textColor="@color/k2go_teal"
            android:textAllCaps="false"
            android:background="@drawable/k2go_getmore_bg" />
    </LinearLayout>
</ScrollView>
