<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4848 (slice 3): Maps Preparing. A CONTAINED placeholder spinner (independent of the
     boot/close Lottie) in a small band, plus a single status line that mirrors what the
     background process is doing (like the boot screen shows the current service). No invented
     progress bar. Mock text until the REST/Ansible backend feeds real output. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k2go_maps_preparing_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/k2go_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/k2go_maps_preparing_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_muted" />

        <!-- ADFA-5074: shared block; the asset is chosen by ProgressVisuals. -->
        <include layout="@layout/view_k2go_working_anim" />

        <!-- The process's own text, not an invented percentage. -->
        <!-- ADFA-4910: fixed 2-line height (minLines=maxLines=2) so the note below never jumps
             as this line flips between 1 and 2 lines. Slightly smaller text (BodyMedium) too.
             Aimed at proot/Ansible installs: their logs are verbose and flip length very fast,
             which made the "Leave it running" card twitch — a static block + smaller line calm it. -->
        <TextView
            android:id="@+id/k2go_prep_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/k2go_maps_phase_prepared"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/k2go_ink" />

        <!-- ADFA-4900: informational note (not a button). Uses the wizard info-card background
             (k2go_info_bg), matching ZIM Preparing, so it no longer reads as a second button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/k2go_info_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_leave_title"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/k2go_info_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/k2go_maps_leave_body"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/k2go_info_ink" />
        </LinearLayout>

        <!-- ADFA-4901: collapsible live log fed by LogRepository (the reusable terminal for all
             proot module installs). Hidden by default; the status line above shows the latest line.
             ADFA-4910: rendered as a tappable text + chevron (NOT a second outlined button next to
             "Run in background"), matching the clone/connect hint style. Tapping reveals the
             terminal; toggleLog() swaps the label and rotates the chevron. -->
        <LinearLayout
            android:id="@+id/k2go_prep_log_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/k2go_prep_log_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k2go_maps_log_show"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/k2go_teal" />

            <ImageView
                android:id="@+id/k2go_prep_log_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/k2go_teal"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/k2go_prep_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@color/k2go_terminal_bg">

            <TextView
                android:id="@+id/k2go_prep_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/k2go_terminal_text"
                android:textIsSelectable="true" />
        </ScrollView>

        <Button
            android:id="@+id/k2go_prep_run_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/k2go_maps_run_bg"
            android:textColor="@color/k2go_teal"
            android:textAllCaps="false"
            android:background="@drawable/k2go_getmore_bg" />
    </LinearLayout>
</ScrollView>
