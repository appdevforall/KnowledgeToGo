    <string name="k2go_kolibri_fit_unknown">சில அளவுகள் வெளியிடப்படவில்லை, எனவே மொத்தம் அதிகமாக இருக்கலாம். தொடரலாம்.</string>
    <string name="k2go_kolibri_takes_body">பாடநெறிகள் மிகப் பெரியதாக இருக்கலாம், குறிப்பாக மெதுவான இணைப்பில் பதிவிறக்க நீண்ட நேரம் ஆகலாம். உங்கள் அமைப்பு நிறுவப்பட்ட பிறகு பதிவிறக்கம் தொடங்கும், பின்னணியில் தொடரும், தடைபட்டால் மீண்டும் தொடரும்.</string>
    <string name="k2go_kolibri_none_in_lang">%1$s இல் இன்னும் பாடநெறிகள் இல்லை · மொழியை மாற்று</string>
    <string name="k2go_kolibri_resources_fmt">%1$d ஆதாரங்கள்</string>
    <string name="k2go_kolibri_tree_offline">பாடநெறி நூலகத்தை அணுக முடியவில்லை. மீண்டும் முயற்சிக்க தட்டவும்.</string>
    <string name="k2go_kolibri_topic_empty">இந்தக் கோப்புறையில் இன்னும் எதுவும் இல்லை.</string>
    <string name="k2go_kolibri_included">மேலே உள்ள கோப்புறையுடன் சேர்க்கப்பட்டது</string>
    <string name="k2go_kolibri_open_topic">கோப்புறையைத் திற</string>
    <string name="k2go_kolibri_choose_topics">தலைப்புகளைத் தேர்வுசெய்</string>
    <string name="k2go_kolibri_narrowed_fmt">%1$d தலைப்புகள் தேர்ந்தெடுக்கப்பட்டன</string>
    <string name="k2go_kolibri_whole_course">முழுப் பாடநெறி</string>
    <string name="k2go_kolibri_checking">இந்தச் சாதனம் என்ன செய்ய முடியும் எனப் பார்க்கப்படுகிறது…</string>
    <string name="k2go_kolibri_not_installed">இந்த அமைப்பில் பாடநெறிகள் நிறுவப்படவில்லை, எனவே உள்ளடக்கம் சேர்க்க முடியாது.</string>
    <string name="k2go_kolibri_system_damaged">உள்ளடக்கம் சேர்ப்பதற்கு முன் உங்கள் அமைப்பு சரிசெய்யப்பட வேண்டும்.</string>
    <string name="k2go_kolibri_start_system_first">முதலில் உங்கள் அமைப்பைத் தொடங்குங்கள், பிறகு இந்தப் பதிவிறக்கம் தொடங்கும்.</string>
    <string name="k2go_kolibri_busy">மற்றொரு பதிவிறக்கம் நடக்கிறது. முடிந்ததும் மீண்டும் முயற்சிக்கவும்.</string>
    <string name="k2go_kolibri_already_here">ஏற்கெனவே இந்தச் சாதனத்தில் உள்ளது</string>
