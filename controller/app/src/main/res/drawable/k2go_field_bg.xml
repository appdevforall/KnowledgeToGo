<?xml version="1.0" encoding="utf-8"?>
<!-- A text input field: the card fill plus a hairline outline, so the field keeps a visible edge on
     a surface-coloured host (for example a pinned bottom bar), not only on the paper background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/k2go_surface" />
    <stroke android:width="1dp" android:color="@color/k2go_hairline" />
    <corners android:radius="18dp" />
</shape>
