<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-385 (01): selected option-card fill. Tonal teal container + teal outline + 11dp corner,
     matching the unselected k2go_pill_bg shape. Tonal, not the solid k2go_chip_bg, so a single-select
     choice does not read as a filled action button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/k2go_teal_tonal" />
    <stroke android:width="1.5dp" android:color="@color/k2go_teal" />
    <corners android:radius="11dp" />
</shape>
