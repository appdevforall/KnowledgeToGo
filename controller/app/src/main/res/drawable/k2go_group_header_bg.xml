<?xml version="1.0" encoding="utf-8"?>
<!-- K2GO-427 / K2GO-269: category header band for the content manager. A tonal fill with a teal
     outline (the prominent-card pattern) so a per-app group header reads as a distinct band above the
     plain item cards. The fill is its own token (k2go_group_header_band); its dark twin is raised so
     the band stays perceptible in dark mode, where the old shared tint read too close to the cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/k2go_group_header_band" />
    <stroke android:width="2dp" android:color="@color/k2go_teal" />
    <corners android:radius="12dp" />
</shape>
