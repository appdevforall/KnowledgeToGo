<?xml version="1.0" encoding="utf-8"?>
<!-- ADFA-4849: filled green notice (e.g. "Fits: X of Y free"). Left accent + pale green body,
     mirroring k2go_warn_bg. A FILLED banner (not an outline) so it never reads as a button. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/k2go_leaf" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/k2go_ok_container" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
