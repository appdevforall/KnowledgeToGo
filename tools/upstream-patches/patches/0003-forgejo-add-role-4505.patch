-  # Small wait loop so 'start' only returns when it's actually alive
+  # Wait loop returns only when MariaDB actually ANSWERS (not merely PID-alive), so
+  # callers that run DB ops right after 'start' don't race a still-initialising server.
   for i in $(seq 1 "$PDSM_START_TIMEOUT"); do
-    if running; then
+    if responds; then
       echo "[pdsm:$SERVICE_NAME] started"
       return 0
     fi
@@ -91,7 +106,9 @@ stop() {
