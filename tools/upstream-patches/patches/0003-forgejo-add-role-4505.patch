diff --git a/roles/forgejo/defaults/main.yml b/roles/forgejo/defaults/main.yml
new file mode 100644
index 0000000000..89c5018c38
--- /dev/null
+++ b/roles/forgejo/defaults/main.yml
@@ -0,0 +1,113 @@
+# forgejo_install: True
+# forgejo_enabled: True
+
+# Sibling of the 'gitea' role. Forgejo is a community fork of Gitea, so its
+# app.ini and CLI are compatible.
+
+# --- Version and download ---------------------------------------------------
+
+# Forgejo has no "latest patch of a branch" URL like dl.gitea.com, so install
+# pins the full LTS version below for a deterministic, offline-reproducible build.
+# TO UPDATE: bump forgejo_version here (or in local_vars), then re-run the role with
+# 'runrole --reinstall forgejo'. On a reinstall the role backs up (forgejo dump)
+# before swapping the binary, then restarts so the DB schema migrations run - it does
+# NOT wipe /library/forgejo/data (repos, DB), so user work is preserved.
+forgejo_lts_major: 15             # current LTS line (v15.x); change when the LTS major moves
+forgejo_version: "15.0.9"         # pinned patch; bump + 'runrole --reinstall forgejo' to update
+
+# forgejo's [git.timeout] MIGRATE (seconds). The forgejo default is 600s, which is
+# too low for large repos with ~1GB it takes around ~15min; raise it so seeding big
+# repos does not time out. Baked into app.ini.j2.
+forgejo_migrate_timeout: 7200
+
+# uname -m -> Forgejo asset suffix. Forgejo ships amd64, arm64 and arm-6 only.
+# 32-bit ARM (arm-6) IS supported; there is NO 32-bit x86 (i386) build, so i386
+# is left out on purpose and resolves to 'unknown' -> the install fails clearly.
+iset_suffixes:
+  x86_64: amd64
+  aarch64: arm64
+  armv7l: arm-6
+  armv6l: arm-6
+  armv8l: arm-6      # 32-bit userland on a 64-bit ARM kernel (e.g. 32-bit app on
+                     # an arm64 phone) reports armv8l via the PER_LINUX32 personality
+
+forgejo_iset_suffix: "{{ iset_suffixes[ansible_facts.machine] | default('unknown') }}"
+
+forgejo_download_base: "https://codeberg.org/forgejo/forgejo/releases/download/v{{ forgejo_version }}"
+forgejo_download_url: "{{ forgejo_download_base }}/forgejo-{{ forgejo_version }}-linux-{{ forgejo_iset_suffix }}"
+forgejo_asc_url: "{{ forgejo_download_url }}.asc"
+forgejo_sha256_url: "{{ forgejo_download_url }}.sha256"
+
+# Forgejo release signing key (keys.openpgp.org). Upstream rotates it regularly
+# and recommends re-fetching each time; GPG verify is best-effort (non-fatal),
+# same approach as the gitea role.
+forgejo_gpg_key: EB114F5E6C0DC2BCDD183550A4B61A2DC5923710
+
+# --- Filesystem layout ------------------------------------------------------
+
+forgejo_root_directory: "{{ content_base }}/forgejo"    # /library/forgejo
+forgejo_subdirectories:
+  - bin
+  - custom
+  - data
+  - data/repositories    # forgejo creates this lazily on the 1st repo; pre-create it so
+                         # 'forgejo dump' (the pre-upgrade backup) works on a repo-less install
+  - log
+  - backups
+
+forgejo_install_path: "{{ forgejo_root_directory }}/bin/forgejo-{{ forgejo_version }}"
+forgejo_asc_path: "{{ forgejo_root_directory }}/bin/forgejo-{{ forgejo_version }}.asc"
+forgejo_link_path: "{{ forgejo_root_directory }}/forgejo"    # stable symlink -> versioned binary
+
+# Data locations (git repos and LFS live on disk, NOT in the database)
+forgejo_repo_root: "{{ forgejo_root_directory }}/data/repositories"
+forgejo_lfs_root: "{{ forgejo_root_directory }}/data/lfs"
+forgejo_db_path: "{{ forgejo_root_directory }}/data/forgejo.db"    # sqlite only
+forgejo_log_root: "{{ forgejo_root_directory }}/log"
+forgejo_backups_root: "{{ forgejo_root_directory }}/backups"       # forgejo dump target (in-place upgrade backup)
+
+# --- Config (/etc/forgejo) --------------------------------------------------
+
+forgejo_config_dir: /etc/forgejo
+forgejo_config_path: "{{ forgejo_config_dir }}/app.ini"
+
+# Secrets are generated once into these files and referenced by *_URI in app.ini
+# (better than gitea's hard-coded keys). See tasks/install.yml (guarded by creates).
+forgejo_secret_key_path: "{{ forgejo_config_dir }}/secret_key"
+forgejo_internal_token_path: "{{ forgejo_config_dir }}/internal_token"
+forgejo_jwt_secret_path: "{{ forgejo_config_dir }}/jwt_secret"
+forgejo_lfs_jwt_secret_path: "{{ forgejo_config_dir }}/lfs_jwt_secret"
+
+forgejo_display_name: Forgejo
+forgejo_run_mode: prod            # gitea uses 'dev'
+forgejo_install_lock: true        # skip the web install screen; first user becomes admin
+
+# --- Database ---------------------------------------------------------------
+
+# 'sqlite' (default, zero extra services, required under proot) or 'mariadb'.
+# The DB only stores metadata, so repo size does not drive this choice; write
+# concurrency does. This only sets up a FRESH DB for the chosen engine.
+# Switching engines on an EXISTING install is refused by the role (no auto-migration).
+# To move data yourself: `forgejo dump`, load it into the new DB (`forgejo restore` /
+# your DB tools), then set forgejo_db_engine to match and re-run to keep updating.
+forgejo_db_engine: sqlite
+forgejo_db_name: forgejo
+forgejo_db_user: forgejo
+forgejo_db_password: changeme     # only when forgejo_db_engine == mariadb; override in local_vars.yml
+
+# --- Runtime user and network ----------------------------------------------
+
+forgejo_user: forgejo
+forgejo_home: "/home/{{ forgejo_user }}"
+forgejo_run_directory: "{{ forgejo_root_directory }}"
+
+forgejo_url: /forgejo
+forgejo_port: 3300                # avoids the kiwix 3000 clash under proot
+
+# Git LFS on by default (helps with large IDE binaries; objects live on disk)
+forgejo_lfs: true
+
+# Built-in SSH server: on for systemd (x86_64/arm64)
+forgejo_enable_ssh: "{{ not is_proot }}"
+forgejo_ssh_port: 2222
+
diff --git a/roles/forgejo/tasks/enable-or-disable.yml b/roles/forgejo/tasks/enable-or-disable.yml
new file mode 100644
index 0000000000..c1891a0353
--- /dev/null
+++ b/roles/forgejo/tasks/enable-or-disable.yml
@@ -0,0 +1,74 @@
+# --- systemd platforms (x86_64/arm64) ---
+
+- name: Enable & Restart 'forgejo' systemd service, if forgejo_enabled (not proot)
+  systemd:
+    name: forgejo
+    daemon_reload: yes
+    enabled: yes
+    state: restarted
+  when:
+    - forgejo_enabled
+    - not is_proot
+
+- name: Disable & Stop 'forgejo' systemd service, if not forgejo_enabled (not proot)
+  systemd:
+    name: forgejo
+    enabled: no
+    state: stopped
+  when:
+    - not forgejo_enabled
+    - not is_proot
+
+
+# --- proot platform (pdsm) ---
+
+- name: Enable & Start 'forgejo' via pdsm (proot), if forgejo_enabled
+  when:
+    - forgejo_enabled
+    - is_proot
+  block:
+    - name: Enable 'forgejo' via pdsm (proot)
+      command: pdsm enable forgejo
+      register: pdsm_enable
+      changed_when: "'already enabled' not in pdsm_enable.stdout"
+
+    - name: Restart 'forgejo' via pdsm (proot)
+      command: pdsm restart forgejo
+
+- name: Disable & Stop 'forgejo' via pdsm (proot), if not forgejo_enabled
+  when:
+    - not forgejo_enabled
+    - is_proot
+  block:
+    - name: Stop 'forgejo' via pdsm (proot)
+      command: pdsm stop forgejo
+      register: pdsm_stop
+      changed_when: "'already stopped' not in pdsm_stop.stdout"
+
+    - name: Disable 'forgejo' via pdsm (proot)
+      command: pdsm disable forgejo
+
+
+# --- NGINX reverse proxy (both platforms) ---
+
+- name: Enable http://box{{ forgejo_url }} via NGINX, by installing {{ nginx_conf_dir }}/forgejo-nginx.conf from template
+  template:
+    src: forgejo-nginx.conf.j2
+    dest: "{{ nginx_conf_dir }}/forgejo-nginx.conf"    # /etc/nginx/conf.d
+  when: forgejo_enabled
+
+- name: Disable http://box{{ forgejo_url }} via NGINX, by removing {{ nginx_conf_dir }}/forgejo-nginx.conf
+  file:
+    path: "{{ nginx_conf_dir }}/forgejo-nginx.conf"    # /etc/nginx/conf.d
+    state: absent
+  when: not forgejo_enabled
+
+- name: Reload 'nginx' systemd service (not proot)
+  systemd:
+    name: nginx
+    state: restarted
+  when: not is_proot
+
+- name: Restart 'nginx' via pdsm (proot)
+  command: pdsm restart nginx
+  when: is_proot
diff --git a/roles/forgejo/tasks/install.yml b/roles/forgejo/tasks/install.yml
new file mode 100644
index 0000000000..d04418b0cb
--- /dev/null
+++ b/roles/forgejo/tasks/install.yml
@@ -0,0 +1,269 @@
+- name: Record (initial) disk space used
+  shell: df -B1 --output=used / | tail -1
+  register: df1
+
+
+# 1. Prepare to install Forgejo: stop any running instance, create user and dirs
+
+- name: Stop existing Forgejo systemd service (if reinstalling, not proot)
+  systemd:
+    name: forgejo
+    state: stopped
+  when: not is_proot
+  ignore_errors: yes
+
+- name: Stop existing Forgejo via pdsm (if reinstalling, proot)
+  command: pdsm stop forgejo
+  when: is_proot
+  ignore_errors: yes
+
+- name: Ensure group 'forgejo' exists
+  group:
+    name: "{{ forgejo_user }}"
+    state: present
+
+- name: Create user 'forgejo'
+  user:
+    name: "{{ forgejo_user }}"
+    comment: Forgejo daemon account
+    group: "{{ forgejo_user }}"
+    home: "{{ forgejo_home }}"    # /home/forgejo
+
+- name: Create {{ forgejo_root_directory }} directory structure
+  file:
+    path: "{{ forgejo_root_directory }}/{{ item }}"    # /library/forgejo
+    state: directory
+    owner: "{{ forgejo_user }}"
+    group: "{{ forgejo_user }}"
+  with_items: "{{ forgejo_subdirectories }}"
+
+- name: Make directories data, log, backups writable (0750)
+  file:
+    path: "{{ forgejo_root_directory }}/{{ item }}"
+    mode: '0750'
+  with_items:
+    - data
+    - log
+    - backups
+
+
+# 1b. In-place upgrade safety. install.yml only runs when 'forgejo_installed' is
+# undefined, i.e. on a fresh install OR on 'runrole --reinstall forgejo' (which
+# clears that flag). This is how a reinstall doubles as the UPDATE path. When an
+# install already exists (app.ini present), back up the DB + repos with 'forgejo
+# dump' BEFORE swapping the binary, so a bad schema migration on the next restart
+# can be recovered. /library/forgejo/data (repos, DB) is never wiped, so user work
+# is preserved. Skipped on a fresh install (nothing to back up).
+
+- name: Check whether Forgejo is already installed (app.ini present)
+  stat:
+    path: "{{ forgejo_config_path }}"
+  register: forgejo_existing_config
+
+# The role sets up a FRESH DB for the chosen engine but never migrates data between
+# engines. Refuse a sqlite<->mariadb switch on an existing install, else we'd silently
+# start on an empty DB and orphan the old data. Manual migration path: see defaults/main.yml.
+- name: Detect the existing install's DB engine (engine-change guard)
+  when: forgejo_existing_config.stat.exists
+  command: "grep -oE '^DB_TYPE[[:space:]]*=[[:space:]]*[A-Za-z0-9]+' {{ forgejo_config_path }}"
+  register: forgejo_existing_db_type
+  changed_when: false
+  failed_when: false
+
+- name: Refuse an unsupported DB engine change on an existing install
+  vars:
+    _cur: "{{ forgejo_existing_db_type.stdout | default('') }}"
+  fail:
+    msg: >-
+      Existing Forgejo install uses '{{ _cur }}' but forgejo_db_engine='{{ forgejo_db_engine }}'.
+      The role does not migrate data between engines. Migrate manually (see
+      roles/forgejo/defaults/main.yml), then set forgejo_db_engine to match and re-run.
+  when:
+    - forgejo_existing_config.stat.exists
+    - (forgejo_db_engine == 'mariadb' and 'sqlite' in _cur) or
+      (forgejo_db_engine == 'sqlite'  and 'mysql'  in _cur)
+
+- name: Back up Forgejo before an in-place upgrade
+  when: forgejo_existing_config.stat.exists
+  block:
+    # ansible_date_time is NOT populated under the proot fact subset
+    # (all,!hardware,!network), so derive the timestamp from 'date' instead.
+    - name: Compute a backup timestamp (proot-safe, no fact dependency)
+      command: date -u +%Y%m%dT%H%M%SZ
+      register: forgejo_backup_ts
+      changed_when: false
+
+    - name: "Back up Forgejo (forgejo dump) to {{ forgejo_backups_root }} before swapping the binary"
+      command: >
+        {{ forgejo_link_path }} dump
+        --config {{ forgejo_config_path }}
+        --file {{ forgejo_backups_root }}/forgejo-dump-{{ forgejo_backup_ts.stdout }}.zip
+      args:
+        chdir: "{{ forgejo_backups_root }}"
+      become: yes
+      become_user: "{{ forgejo_user }}"
+
+
+# 2. Download, verify, and link the Forgejo binary
+
+- name: Fail if we detect an unsupported CPU architecture
+  fail:
+    msg: "No Forgejo binary for CPU architecture \"{{ ansible_facts.machine }}\" (Forgejo ships amd64, arm64, arm-6 only; 32-bit x86 is unsupported)"
+  when: forgejo_iset_suffix == "unknown"
+
+- name: Download Forgejo binary {{ forgejo_download_url }} to {{ forgejo_install_path }} (0775, ~100 MB, SLOW)
+  get_url:
+    url: "{{ forgejo_download_url }}"
+    dest: "{{ forgejo_install_path }}"    # /library/forgejo/bin/forgejo-<ver>
+    mode: "0775"
+    timeout: "{{ download_timeout }}"
+
+- name: Download Forgejo GPG signature {{ forgejo_asc_url }} to {{ forgejo_asc_path }}
+  get_curl:
+    url: "{{ forgejo_asc_url }}"
+    dest: "{{ forgejo_asc_path }}"
+    timeout: "{{ download_timeout }}"
+
+- name: Verify Forgejo binary with GPG signature (best-effort, non-fatal like the gitea role)
+  shell: |
+    gpg --keyserver keys.openpgp.org --recv {{ forgejo_gpg_key }}
+    gpg --verify {{ forgejo_asc_path }} {{ forgejo_install_path }}
+  ignore_errors: yes
+
+- name: Symlink {{ forgejo_link_path }} -> {{ forgejo_install_path }}
+  file:
+    src: "{{ forgejo_install_path }}"
+    path: "{{ forgejo_link_path }}"    # /library/forgejo/forgejo
+    owner: "{{ forgejo_user }}"
+    group: "{{ forgejo_user }}"
+    state: link
+    force: yes
+
+# An update (runrole --reinstall forgejo) downloads a new bin/forgejo-<ver> and repoints
+# the symlink above; the superseded binary (~110 MB each) would otherwise pile up in bin/.
+# Keep only the active version and its .asc, so disk growth per update stays bounded.
+- name: Find installed Forgejo binaries in {{ forgejo_install_path | dirname }}
+  find:
+    paths: "{{ forgejo_install_path | dirname }}"    # /library/forgejo/bin
+    patterns: "forgejo-*"
+  register: forgejo_bin_files
+
+- name: Remove superseded Forgejo binaries (keep only {{ forgejo_version }})
+  file:
+    path: "{{ item.path }}"
+    state: absent
+  loop: "{{ forgejo_bin_files.files }}"
+  loop_control:
+    label: "{{ item.path | basename }}"
+  when:
+    - forgejo_version | string | length > 0        # never prune when the version is unset
+    - (item.path | basename) != ('forgejo-' ~ forgejo_version)
+    - (item.path | basename) != ('forgejo-' ~ forgejo_version ~ '.asc')
+
+
+# 3. Configure Forgejo (/etc/forgejo)
+
+- name: mkdir {{ forgejo_config_dir }} (0770 root:forgejo)
+  file:
+    state: directory
+    path: "{{ forgejo_config_dir }}"
+    owner: root
+    group: "{{ forgejo_user }}"
+    mode: "0770"
+
+- name: Generate Forgejo secrets once (guarded by 'creates'), referenced by *_URI in app.ini
+  shell: "umask 027; {{ forgejo_link_path }} generate secret {{ item.kind }} > {{ item.path }}"
+  args:
+    creates: "{{ item.path }}"
+  with_items:
+    - { kind: SECRET_KEY, path: "{{ forgejo_secret_key_path }}" }
+    - { kind: INTERNAL_TOKEN, path: "{{ forgejo_internal_token_path }}" }
+    - { kind: JWT_SECRET, path: "{{ forgejo_jwt_secret_path }}" }
+    - { kind: LFS_JWT_SECRET, path: "{{ forgejo_lfs_jwt_secret_path }}" }
+
+- name: Secure the generated secret files (0640 root:forgejo)
+  file:
+    path: "{{ item }}"
+    owner: root
+    group: "{{ forgejo_user }}"
+    mode: "0640"
+  with_items:
+    - "{{ forgejo_secret_key_path }}"
+    - "{{ forgejo_internal_token_path }}"
+    - "{{ forgejo_jwt_secret_path }}"
+    - "{{ forgejo_lfs_jwt_secret_path }}"
+
+
+# 3b. MariaDB backend (wired option; default engine is sqlite). Engine migration
+#     from an existing sqlite DB is a later PR - this only sets up a fresh DB.
+
+- name: Set up MariaDB backend for Forgejo
+  when: forgejo_db_engine == 'mariadb'
+  block:
+    - name: "Set 'mysql_install: True' and 'mysql_enabled: True'"
+      set_fact:
+        mysql_install: True
+        mysql_enabled: True
+
+    - name: MYSQL - run 'mysql' role
+      include_role:
+        name: mysql
+
+    - name: FAIL (STOP THE INSTALL) IF 'mysql_installed is undefined'
+      fail:
+        msg: "Forgejo needs MariaDB but the 'mysql' role did not install it."
+      when: mysql_installed is undefined
+
+    - name: "Create MySQL database for Forgejo: {{ forgejo_db_name }}"
+      ansible.mariadb.mariadb_db:
+        name: "{{ forgejo_db_name }}"
+
+    - name: Create MySQL username ({{ forgejo_db_user }}) with password, for above database
+      ansible.mariadb.mariadb_user:
+        name: "{{ forgejo_db_user }}"
+        password: "{{ forgejo_db_password }}"
+        priv: "{{ forgejo_db_name }}.*:ALL,GRANT"
+
+- name: Install {{ forgejo_config_path }} from template (0664 root:forgejo)
+  template:
+    src: app.ini.j2
+    dest: "{{ forgejo_config_path }}"
+    owner: root
+    group: "{{ forgejo_user }}"
+    mode: "0664"
+
+
+# 4. Service unit (systemd platforms only)
+# Under proot the pdsm wrapper is provided by the 'proot_services' role
+# (roles/proot_services/files/pdsm/usr_local_pdsm/services-available/forgejo,
+# listed in its 'pdsm_installed_services'); this role only enables/starts it.
+
+- name: "Install systemd unit /etc/systemd/system/forgejo.service (not proot)"
+  template:
+    src: forgejo.service.j2
+    dest: /etc/systemd/system/forgejo.service
+  when: not is_proot
+
+
+# 5. RECORD Forgejo AS INSTALLED
+
+- name: Record (final) disk space used
+  shell: df -B1 --output=used / | tail -1
+  register: df2
+
+- name: Add 'forgejo_disk_usage = {{ df2.stdout | int - df1.stdout | int }}' to {{ iiab_ini_file }}
+  ini_file:
+    path: "{{ iiab_ini_file }}"    # /etc/iiab/iiab.ini
+    section: forgejo
+    option: forgejo_disk_usage
+    value: "{{ df2.stdout | int - df1.stdout | int }}"
+
+- name: "Set 'forgejo_installed: True'"
+  set_fact:
+    forgejo_installed: True
+
+- name: "Add 'forgejo_installed: True' to {{ iiab_state_file }}"
+  lineinfile:
+    path: "{{ iiab_state_file }}"    # /etc/iiab/iiab_state.yml
+    regexp: '^forgejo_installed'
+    line: 'forgejo_installed: True'
