-  if running; then
+  # Report running only if it is alive AND actually answers, so a broken orphan is not
+  # misreported as healthy (and so pdsm's require_service restarts a stale dependency).
+  if running && responds; then
     echo "[pdsm:$SERVICE_NAME] running"
     return 0
   fi
