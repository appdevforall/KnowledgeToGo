+def resolve_source(source, tmp):
+    # A resume can only continue the partial from the SAME mirror recorded in its
+    # <output>.resume journal; get_mirror() shuffles, so on a retry reuse that mirror.
+    journal = Path(str(tmp) + ".resume")
+    if journal.exists():
+        try:
+            j = json.loads(journal.read_text())
+            bucket, key = j.get("bucket"), j.get("key")
+            if bucket and key:
+                pinned = bucket + "/" + key
+                if requests.head(pinned).status_code == 200:
+                    return pinned
+        except (json.JSONDecodeError, OSError, requests.RequestException):
+            pass
+    return get_mirror(source)
