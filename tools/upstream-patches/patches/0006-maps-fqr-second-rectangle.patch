                         for (let feature of thisControl._drawControl.getFeatures().features) {
                             if (feature.id !== id) {
-                                this._terraDrawInstance.removeFeatures([feature.id])
+                                thisControl._terraDrawInstance.removeFeatures([feature.id])
                             }
                         }
                     }
