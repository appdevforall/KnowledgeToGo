Upstream-PR:     not yet submitted
Upstream-Status: open
Applies-to:      roles/kolibri/tasks/install.yml
Summary:         Set DISABLE_PING = True in options.ini on proot. Kolibri otherwise sends its instance IDs and facility statistics to telemetry.learningequality.org at each start and every 24 h (K2GO-559).

diff --git a/roles/kolibri/tasks/install.yml b/roles/kolibri/tasks/install.yml
index 7e921a0..bf9ad6d 100644
--- a/roles/kolibri/tasks/install.yml
+++ b/roles/kolibri/tasks/install.yml
@@ -249,6 +249,14 @@
         value: "{{ kolibri_http_port }}"
         create: true
 
+    - name: Disable the statistics pingback at options.ini (proot)
+      ini_file:
+        dest: "{{ kolibri_home }}/options.ini"
+        section: "Deployment"
+        option: "DISABLE_PING"
+        value: "True"
+        create: true
+
 
