# conex-core operator overrides (systemd/IIAB path, not proot). Written by
# roles/conex_core at 0600. The core reads K2GO_CALIBRE_USER / _PASS first, then its
# own fallback (IIAB app.db default Admin / changeme). Only values an operator set
# are emitted, so a stock box leaves this file comment-only and the core default
# stays in effect. K2GO-512.
{% if conex_core_calibre_user and conex_core_calibre_pass %}
K2GO_CALIBRE_USER={{ conex_core_calibre_user }}
K2GO_CALIBRE_PASS={{ conex_core_calibre_pass }}
{% endif %}
