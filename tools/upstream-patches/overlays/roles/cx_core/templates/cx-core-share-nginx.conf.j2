# cx-core Share listener (K2GO-376, Pillar Share). The ONLY off-loopback surface of
# the content-exchange core. Installed by roles/cx_core (tasks/enable-or-disable.yml).
#
# A paired peer on the hotspot PULLS selected content from this box. cx-core stays
# bound to 127.0.0.1; this dedicated listener proxies ONLY /v1/share/<session>/... to
# it. A dedicated port cannot leak the rest of the /v1 API the way a widened location
# on the shared :8085 server could. The share-session token (X-Share-Token header) is
# the real auth, enforced inside cx-core; this scope is defense in depth.
#
# Plain HTTP by design: the link is the closed local hotspot and the token is the
# auth. A self-signed cert the offline peers cannot verify adds no trust here. See
# controller/docs/cx-core-share-exposure.md and ADR-content-exchange.md "Pillar Share".
#
# ROOTFS NOTE: a "server" block must be included at the nginx http context. IIAB's
# /etc/nginx/conf.d holds LOCATION snippets included inside the :8085 server block, so
# this file cannot live there. The rootfs includes it at http level (see the doc).

server {
    listen 0.0.0.0:{{ cx_core_share_port }};    # plain HTTP: the gate token is the auth
    server_name _;

    # Collapse repeated slashes, so "/v1/share//" cannot slip past the create guard
    # below. cx-core strips a trailing slash, so /v1/share/ maps to the create call.
    merge_slashes on;

    # Deny by default: nothing on this port is reachable unless a rule below allows it.
    location / {
        return 404;
    }

    # Block session creation. POST /v1/share mints a token for ARBITRARY items, so it
    # is NEVER exposed off-box (the sender creates the session in-box over loopback).
    # cx-core strips the trailing slash, so /v1/share/ reaches create too: block it.
    location = /v1/share/ {
        return 404;
    }

    # The receiver surface only: GET .../manifest, GET .../fetch/<ref>,
    # POST .../complete, DELETE /v1/share/<session>. Every one is token-gated inside
    # cx-core (401 no token, 403 mismatch, 404 unknown session). "^~" keeps a future
    # regex location from overriding this prefix match.
    location ^~ /v1/share/ {
        proxy_pass http://127.0.0.1:{{ cx_core_port }};
        proxy_http_version 1.1;
        proxy_buffering off;              # stream multi-GB items; do not buffer to disk
        proxy_request_buffering off;
        proxy_read_timeout 3600s;         # a large item over a slow hotspot link
        proxy_send_timeout 3600s;
    }
}
