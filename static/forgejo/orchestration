# Description : K2GO-212. Forgejo repo seeding for the K2Go bake. Sourced by the
#               installer ONLY when ENABLE_FORGEJO_SEED=1. Holds the config
#               (env-overridable) and the orchestration function seed_forgejo.
#               Guard-based and idempotent: Forgejo is the single source of truth
#               (it already knows which repos exist and whether they are empty),
#               so re-running needs no local state file.
#
# The seeding method is "shallow": a shallow single-branch bare clone adopted
# into Forgejo. The migrate API does a FULL clone and cannot go shallow, so the
# bake clones the shallow dir and adopts it. This carries the full current tree
# (compiles to a working APK) and drops the dead git history: CoGo 1.2 GB -> ~150 MB.
# Study: Confluence "Code on the Go (CoGo) - repo size, subset strategy &
# offline-compile validation".
# ============================================================================

# ===== CONFIG (env overrides win) ==========================================
FORGEJO_BIN="${FORGEJO_BIN:-/library/forgejo/forgejo}"          # absolute: 'forgejo' is NOT on the forgejo user's PATH under su
FORGEJO_CONFIG="${FORGEJO_CONFIG:-/etc/forgejo/app.ini}"
FORGEJO_RUN_USER="${FORGEJO_RUN_USER:-forgejo}"
FORGEJO_REPO_ROOT="${FORGEJO_REPO_ROOT:-/library/forgejo/data/repositories}"

# Talk to forgejo DIRECTLY (bypass nginx). A synchronous migrate through nginx
# can hit proxy_read_timeout and make forgejo ROLL BACK the repo. forgejo serves
# its ROOT at :3300, so the API is :3300/api/v1 (nginx strips the /forgejo prefix).
FORGEJO_API="${FORGEJO_API:-http://127.0.0.1:3300/api/v1}"
# Health gate goes THROUGH nginx on purpose: a healthy K2Go needs nginx up too,
# not just forgejo. :8085 is the box nginx; /forgejo/ proxies to :3300.
FORGEJO_HEALTH="${FORGEJO_HEALTH:-http://127.0.0.1:8085/forgejo/}"

# K2GO-417: the admin credential's single source is dash-node credentials.ts (the value the WebView
# auto-login reads via GET /k2go-api/credentials/forgejo). Capture whether the caller set the admin
# user/pass explicitly in the env BEFORE the literal fallbacks apply, so _fj_resolve_admin_creds knows
# not to override an explicit value. The literals below are ONLY the last-resort fallback used when
# dash-node is unreachable (e.g. an offline bake); they must stay equal to credentials.ts DEFAULTS.forgejo.
_FJ_ADMIN_USER_ENV="${FORGEJO_ADMIN_USER:-}"
_FJ_ADMIN_PASS_ENV="${FORGEJO_ADMIN_PASS:-}"
FORGEJO_ADMIN_USER="${FORGEJO_ADMIN_USER:-k2goadmin}"          # 'admin' is RESERVED by forgejo
FORGEJO_ADMIN_PASS="${FORGEJO_ADMIN_PASS:-changeme}"          # fallback only; the source of truth is credentials.ts
FORGEJO_ADMIN_EMAIL="${FORGEJO_ADMIN_EMAIL:-k2go@box.lan}"
FORGEJO_CRED_URL="${FORGEJO_CRED_URL:-http://127.0.0.1:8085/k2go-api/credentials/forgejo}"

# Repos live under an org (full-name mirrors of the originals); contributors fork. Admin owns the org.
FORGEJO_ORG="${FORGEJO_ORG:-AppDevForAll}"

FORGEJO_PROOT="${FORGEJO_PROOT:-1}"                            # 1 on K2Go (proot): enables the l2s double-rm
FORGEJO_WAIT_TRIES="${FORGEJO_WAIT_TRIES:-60}"                # 502 window tolerance (x 5s ~= 5 min)
# "shallow" (git clone --bare --depth 1 + adopt; recommended) or "migrate"
# (forgejo migrate API, full mirror). Shallow keeps the full current tree and
# drops history; the migrate API cannot go shallow.
FORGEJO_SEED_METHOD="${FORGEJO_SEED_METHOD:-shallow}"

# Canonical repo definitions (owner|name|clone_addr|branch; branch optional -> default). One source
# per repo; the tier lists compose from these, and the installer gate picks a tier by name.
_FJ_REPO_K2GO="${FORGEJO_ORG}|KnowledgeToGo|https://github.com/appdevforall/KnowledgeToGo|"
_FJ_REPO_COGO="${FORGEJO_ORG}|CodeOnTheGo|https://github.com/appdevforall/CodeOnTheGo|stage"
_FJ_REPO_ADDONS="${FORGEJO_ORG}|addons|https://github.com/appdevforall/addons|"
# Medium (standard): k2go + cogo. Large (full): + addons. Basic has forgejo off, so it seeds nothing.
FORGEJO_REPOS_STANDARD="$_FJ_REPO_K2GO
$_FJ_REPO_COGO"
FORGEJO_REPOS_FULL="$_FJ_REPO_K2GO
$_FJ_REPO_COGO
$_FJ_REPO_ADDONS"
FORGEJO_REPOS="${FORGEJO_REPOS:-$FORGEJO_REPOS_FULL}"

# ===== small helpers (reuse installer's log/ok/warn if present) ============
command -v log  >/dev/null 2>&1 || log(){ printf '  %s\n' "$*"; }
command -v ok   >/dev/null 2>&1 || ok(){  printf '  OK: %s\n' "$*"; }
command -v warn >/dev/null 2>&1 || warn(){ printf '  WARN: %s\n' "$*" >&2; }

_fj_su()   { su -s /bin/sh "$FORGEJO_RUN_USER" -c "$1"; }          # run as the forgejo user
_fj_api()  { curl -fsS -u "$FORGEJO_ADMIN_USER:$FORGEJO_ADMIN_PASS" "$@"; }
_fj_lc()   { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }     # Forgejo stores repos at lowercased on-disk paths
# Example repos are reference material: they must be public (browsable + forkable without a login).
# Adopt/create default to private, so set it explicitly. Idempotent (a re-seed also fixes an old private one).
_fj_ensure_public() {
  _fj_api -X PATCH "$FORGEJO_API/repos/$1/$2" -H 'Content-Type: application/json' -d '{"private":false}' >/dev/null 2>&1 \
    && log "public $1/$2" || warn "could not set $1/$2 public"
}

# Wait for forgejo to answer 200 THROUGH nginx (tolerate the post-restart 502 window).
_fj_wait_200() {
  local i=0
  while [ "$i" -lt "$FORGEJO_WAIT_TRIES" ]; do
    [ "$(curl -s -o /dev/null -w '%{http_code}' "$FORGEJO_HEALTH")" = "200" ] && { ok "forgejo is serving 200"; return 0; }
    i=$((i+1)); sleep 5
  done
  warn "forgejo did not reach 200 after $((FORGEJO_WAIT_TRIES*5))s"; return 1
}

# K2GO-417: resolve the admin credential from the single source (dash-node credentials.ts) unless the
# caller set it in the env. Keeps the seed and the WebView auto-login from drifting: both read the same
# value. Best-effort: if dash-node is unreachable the built-in fallback (equal to credentials.ts
# DEFAULTS.forgejo) stands, so the bake still seeds offline. The endpoint reveals the password only when
# it is the box default (a custom override is hidden), which is exactly the "known default" case here.
_fj_resolve_admin_creds() {
  local j u p
  j="$(curl -fsS --max-time 5 "$FORGEJO_CRED_URL" 2>/dev/null)" || {
    log "admin cred: dash-node unreachable; using the built-in default"; return 0; }
  u="$(printf '%s' "$j" | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')"
  p="$(printf '%s' "$j" | sed -n 's/.*"password":"\([^"]*\)".*/\1/p')"
  [ -z "$_FJ_ADMIN_USER_ENV" ] && [ -n "$u" ] && FORGEJO_ADMIN_USER="$u"
  [ -z "$_FJ_ADMIN_PASS_ENV" ] && [ -n "$p" ] && FORGEJO_ADMIN_PASS="$p"
  log "admin cred: resolved from dash-node credentials.ts (single source)"
}

# Admin (guard: create only if missing; run as forgejo user, absolute binary path).
_fj_ensure_admin() {
  if _fj_su "$FORGEJO_BIN admin user list --config $FORGEJO_CONFIG" 2>/dev/null | awk '{print $2}' | grep -qx "$FORGEJO_ADMIN_USER"; then
    log "admin '$FORGEJO_ADMIN_USER' already exists"; return 0
  fi
  _fj_su "$FORGEJO_BIN admin user create --admin --username '$FORGEJO_ADMIN_USER' \
      --password '$FORGEJO_ADMIN_PASS' --email '$FORGEJO_ADMIN_EMAIL' \
      --must-change-password=false --config $FORGEJO_CONFIG" \
    && ok "admin '$FORGEJO_ADMIN_USER' created" || { warn "admin create failed"; return 1; }
}

# Org (guard: create only if missing). Owned by the admin user; repos live under it.
_fj_ensure_org() {
  if _fj_api "$FORGEJO_API/orgs/$FORGEJO_ORG" >/dev/null 2>&1; then
    log "org '$FORGEJO_ORG' already exists"; return 0
  fi
  if _fj_api -X POST "$FORGEJO_API/orgs" -H 'Content-Type: application/json' \
       -d "{\"username\":\"$FORGEJO_ORG\",\"visibility\":\"public\"}" >/dev/null 2>&1; then
    ok "org '$FORGEJO_ORG' created"
  else
    warn "org '$FORGEJO_ORG' create failed"; return 1
  fi
}

# Guard: repo exists AND is non-empty (a dangling/empty repo dir still 409s on re-seed).
_fj_repo_ready() {
  _fj_api "$FORGEJO_API/repos/$1/$2" 2>/dev/null | grep -q '"empty":false'
}

# Purge a broken/empty repo before retry. On proot, a single rm leaves dangling
# link2symlink (l2s) entries -> the dir survives -> next seed 409s. So rm TWICE (+ once more).
_fj_purge_repo() {
  local owner="$1" name="$2" dir="$FORGEJO_REPO_ROOT/$(_fj_lc "$1")/$(_fj_lc "$2").git"
  _fj_api -X DELETE "$FORGEJO_API/repos/$owner/$name" >/dev/null 2>&1 || true
  if [ "$FORGEJO_PROOT" = "1" ]; then
    rm -rf "$dir" 2>/dev/null; rm -rf "$dir" 2>/dev/null; rm -rf "$dir" 2>/dev/null
  else
    rm -rf "$dir" 2>/dev/null
  fi
}

# Method A: full mirror via the migrate API (direct :3300, bypassing nginx).
# K2GO-212: keep the failure output for debugging instead of discarding it.
_fj_migrate() {
  local owner="$1" name="$2" addr="$3" out
  out="$(_fj_api -X POST "$FORGEJO_API/repos/migrate" -H 'Content-Type: application/json' \
    -d "{\"clone_addr\":\"$addr\",\"repo_owner\":\"$owner\",\"repo_name\":\"$name\",\"service\":\"git\",\"mirror\":false}" 2>&1)" \
    || { warn "migrate $owner/$name failed: $out"; return 1; }
}

# Method B: shallow snapshot -> adopt (recommended; full current tree, compilable, no history).
# K2GO-212: keep the failure output for debugging.
# K2GO-422: clone at depth 20 (not 1). ~0 extra size on these repos, but it keeps a short recent
# history so the web UI shows the last changes and so a later refresh has a merge base to compare
# against (git ancestry is the single source; no extra on-disk marker is written).
_fj_shallow_adopt() {
  local owner="$1" name="$2" addr="$3" branch="$4" out
  # Forgejo derives the on-disk path as <root>/<owner_lc>/<repo_lc>.git (RepoPath lowercases owner and
  # repo), so the bare clone must land at the lowercased path or the adopt call gets 404 (dir not found).
  # The adopt API keeps the original case, so the repo keeps its display name (e.g. CodeOnTheGo).
  local ldir="$FORGEJO_REPO_ROOT/$(_fj_lc "$owner")"
  local dir="$ldir/$(_fj_lc "$name").git"
  local br=""; [ -n "$branch" ] && br="--branch $branch"
  mkdir -p "$ldir"
  # shellcheck disable=SC2086
  out="$(git clone --bare --depth 20 --single-branch $br "$addr" "$dir" 2>&1)" \
    || { warn "clone $owner/$name failed: $out"; return 1; }
  chown -R "$FORGEJO_RUN_USER:$FORGEJO_RUN_USER" "$ldir"
  out="$(_fj_api -X POST "$FORGEJO_API/admin/unadopted/$owner/$name" 2>&1)" \
    || { warn "adopt $owner/$name failed: $out"; return 1; }   # HTTP 204 on success
}

# Seed one repo (guard -> purge-if-broken -> seed -> verify).
_fj_seed_one() {
  local owner="$1" name="$2" addr="$3" branch="$4"
  if _fj_repo_ready "$owner" "$name"; then log "skip $owner/$name (already seeded)"; _fj_ensure_public "$owner" "$name"; return 0; fi
  log "seeding $owner/$name  [$FORGEJO_SEED_METHOD]"
  _fj_purge_repo "$owner" "$name"
  if [ "$FORGEJO_SEED_METHOD" = "migrate" ]; then _fj_migrate "$owner" "$name" "$addr"
  else _fj_shallow_adopt "$owner" "$name" "$addr" "$branch"; fi
  if _fj_repo_ready "$owner" "$name"; then _fj_ensure_public "$owner" "$name"; ok "seeded $owner/$name"; else warn "FAILED $owner/$name"; return 1; fi
}

# ===== entry point (what the installer gate calls) =========================
seed_forgejo() {
  _fj_wait_200 || return 1
  _fj_resolve_admin_creds        # K2GO-417: derive the admin credential from credentials.ts (single source)
  _fj_ensure_admin || return 1
  _fj_ensure_org || return 1
  printf '%s\n' "$FORGEJO_REPOS" | while IFS='|' read -r owner name addr branch; do
    [ -n "$owner" ] && [ -n "$addr" ] || continue
    _fj_seed_one "$owner" "$name" "$addr" "$branch" || true   # one repo must not abort the rest
  done
  ok "forgejo seeding done"
}

# ===== K2GO-422: live repo refresh (non-destructive) =======================
# Refresh the seeded example repos from their upstreams WITHOUT a box stop and
# WITHOUT ever losing a local commit. Per repo:
#   up to date : the served branch equals upstream -> nothing to do.
#   pristine   : the served branch is an ancestor of upstream -> fast-forward.
#   diverged   : the owner committed on the served branch. Try a real 3-way merge
#                with git merge-tree (no worktree is needed on a bare repo):
#                clean    -> commit the merge and advance (keeps their commits);
#                conflict -> leave the branch AS IS and report "blocked" (the
#                owner reconciles in the forge web UI, not here).
# pristine vs diverged is DERIVED from git ancestry, so no extra on-disk marker is
# kept (git history is the single source). The served branch only ever moves
# FORWARD (every push is a fast-forward), so a refresh can never drop a commit.
# Ref moves go THROUGH forgejo (an authenticated push) so its hooks fire and the
# forge metadata stays in sync, unlike a raw update-ref.

# Advance a branch to <commit> by pushing THROUGH forgejo (fires its hooks). The
# push is always a fast-forward (<commit> has the old tip as an ancestor), so it
# can never be destructive; forgejo rejects a non-ff, which we treat as a skip.
_fj_push_branch() {
  local owner="$1" name="$2" commit="$3" br="$4"
  local dir="$FORGEJO_REPO_ROOT/$(_fj_lc "$owner")/$(_fj_lc "$name").git"
  local auth; auth="$(printf '%s:%s' "$FORGEJO_ADMIN_USER" "$FORGEJO_ADMIN_PASS" | base64 | tr -d '\n')"
  git -C "$dir" -c "http.extraHeader=Authorization: Basic $auth" \
    push "http://127.0.0.1:3300/$owner/$name.git" "$commit:refs/heads/$br" >/dev/null 2>&1
}

# Write the repo description as a human status board. It is a PROJECTION: rebuilt
# every run from git state + the two stored timestamps, never read back as
# authority. State is derived from the served branch vs the last-fetched upstream
# side ref; the two timestamps live in the repo git config (their only home).
# NOTE: the "--[ ... ]--" section markers are a DELIBERATE exception to the no-"--"
# rule, allowed only because this string never enters an XML resource. ASCII-only;
# do NOT copy this template into strings.xml (-- is illegal in an XML comment).
_fj_write_desc() {
  local owner="$1" name="$2" dir br cur up state lu la d
  dir="$FORGEJO_REPO_ROOT/$(_fj_lc "$owner")/$(_fj_lc "$name").git"
  br="$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null)"
  cur="$(git -C "$dir" rev-parse "refs/heads/$br" 2>/dev/null)"
  up="$(git -C "$dir" rev-parse "refs/k2go/upstream/$br" 2>/dev/null)"
  if [ -z "$up" ] || [ "$cur" = "$up" ]; then state="updatable"
  elif git -C "$dir" merge-base --is-ancestor "$cur" "$up" 2>/dev/null; then state="updatable"
  elif git -C "$dir" merge-base --is-ancestor "$up" "$cur" 2>/dev/null; then state="diverged, updatable"
  else state="diverged, blocked"; fi
  lu="$(git -C "$dir" config --get k2go.lastupdate 2>/dev/null)";  [ -n "$lu" ] || lu="n/a"
  la="$(git -C "$dir" config --get k2go.lastattempt 2>/dev/null)"; [ -n "$la" ] || la="n/a"
  d="$name example repo. To keep it evergreen, please fork it and apply your changes to your own fork; avoid committing to this branch so we can keep it in sync later on. --[ Last Update: $lu ]-- --[ Last Attempt: $la ]-- --[ Status: $state ]--"
  _fj_api -X PATCH "$FORGEJO_API/repos/$owner/$name" -H 'Content-Type: application/json' \
    -d "{\"description\":\"$d\"}" >/dev/null 2>&1 || warn "desc update failed $owner/$name"
}

# Refresh one repo (guard -> fetch to a side ref -> classify -> ff/merge/skip -> desc).
_fj_refresh_one() {
  local owner="$1" name="$2" addr="$3" branch="$4"
  local dir="$FORGEJO_REPO_ROOT/$(_fj_lc "$owner")/$(_fj_lc "$name").git"
  local now; now="$(date -u '+%Y-%m-%d %H:%M UTC')"
  if ! _fj_repo_ready "$owner" "$name"; then log "refresh skip $owner/$name (not seeded)"; return 0; fi
  [ -d "$dir" ] || { warn "refresh skip $owner/$name (no on-disk dir)"; return 0; }
  local br="$branch"
  [ -n "$br" ] || br="$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null)"
  [ -n "$br" ] || { warn "refresh skip $owner/$name (no branch)"; return 0; }
  git -C "$dir" config k2go.lastattempt "$now"   # attempt recorded regardless of outcome
  local uref="refs/k2go/upstream/$br"
  if ! git -C "$dir" fetch --depth 20 "$addr" "+$br:$uref" >/dev/null 2>&1; then
    warn "refresh fetch failed $owner/$name (offline?)"; _fj_write_desc "$owner" "$name"; return 0
  fi
  local cur up; cur="$(git -C "$dir" rev-parse "refs/heads/$br")"; up="$(git -C "$dir" rev-parse "$uref")"
  # If neither tip is an ancestor of the other, the link may just be cut by the shallow boundary (a repo
  # that fell more than ~20 commits behind upstream). Deepen once and re-read upstream BEFORE deciding it
  # is diverged, so a far-behind PRISTINE repo fast-forwards instead of being falsely reported "blocked".
  if [ -n "$cur" ] && [ -n "$up" ] && [ "$cur" != "$up" ] \
     && ! git -C "$dir" merge-base --is-ancestor "$cur" "$up" 2>/dev/null \
     && ! git -C "$dir" merge-base --is-ancestor "$up" "$cur" 2>/dev/null; then
    git -C "$dir" fetch --deepen 200 "$addr" "+$br:$uref" >/dev/null 2>&1 || true
    up="$(git -C "$dir" rev-parse "$uref")"
  fi
  if [ "$cur" = "$up" ]; then
    git -C "$dir" config k2go.lastupdate "$now"; log "refresh up-to-date $owner/$name"
  elif git -C "$dir" merge-base --is-ancestor "$cur" "$up"; then
    if _fj_push_branch "$owner" "$name" "$up" "$br"; then
      git -C "$dir" config k2go.lastupdate "$now"; ok "refresh fast-forward $owner/$name"
    else warn "refresh ff push failed $owner/$name"; fi
  elif git -C "$dir" merge-base --is-ancestor "$up" "$cur"; then
    # the served branch already contains all of upstream (local commits sit on top)
    # -> nothing to pull. A no-op, so a diverged-but-merged repo does not pile a
    # redundant merge commit on every refresh.
    git -C "$dir" config k2go.lastupdate "$now"; log "refresh already ahead $owner/$name"
  else
    local tree merged
    if tree="$(git -C "$dir" merge-tree --write-tree "$cur" "$up" 2>/dev/null)"; then
      merged="$(GIT_AUTHOR_NAME=K2Go GIT_AUTHOR_EMAIL=k2go@box.lan GIT_COMMITTER_NAME=K2Go GIT_COMMITTER_EMAIL=k2go@box.lan \
        git -C "$dir" commit-tree "$tree" -p "$cur" -p "$up" -m "Merge upstream into $br (K2Go refresh)" 2>/dev/null)"
      if [ -n "$merged" ] && _fj_push_branch "$owner" "$name" "$merged" "$br"; then
        git -C "$dir" config k2go.lastupdate "$now"; ok "refresh merged upstream into $owner/$name"
      else warn "refresh merge push failed $owner/$name"; fi
    else
      warn "refresh conflict $owner/$name (left as is; reconcile in the web UI)"
    fi
  fi
  _fj_write_desc "$owner" "$name"
}

# ===== entry point: refresh (what the dash-node refresh endpoint calls) =====
refresh_forgejo() {
  _fj_wait_200 || return 1
  _fj_resolve_admin_creds        # same single-source admin credential the seed uses
  printf '%s\n' "$FORGEJO_REPOS" | while IFS='|' read -r owner name addr branch; do
    [ -n "$owner" ] && [ -n "$addr" ] || continue
    _fj_refresh_one "$owner" "$name" "$addr" "$branch" || true   # one repo must not abort the rest
  done
  ok "forgejo refresh done"
}
